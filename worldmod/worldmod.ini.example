; worldmod settings. Each launcher exe reads the section named after itself.
[mod]
enable=1
verify_only=0
; ascii_dir: an ASCII path to the game directory (e.g. a junction). When the game is started from a
; path the system's ANSI code page cannot represent, worldmod restarts it from here. Without it, worldmod
; looks for a junction in the root of each fixed drive that points to the game directory.
; ascii_dir=G:\San11PK

; stock exe: original 200x200 map (arrays relocated, everything else unchanged)
[san11pk]
width=200
height=200
china_x=0
china_y=0

; san11pk_world.exe (LAA + 48 MB stack, made by tools/make_world_exe.py): the Eurasia world with 210 cities.
; width/height: multiples of 200 (width = columns, north-south; height = rows, west-east).
; china_x/china_y: where Koei's 200x200 China map sits (china_y even).
[san11pk_world]
; world_terrain: whole-world 3D terrain (M4B.md)
world_terrain=1
; data_dir: world data, inside the game directory (tools/editor or the tools in TUTORIAL.md section 10)
data_dir=world_eurasia210
width=1000
height=1800
china_x=436
china_y=1234
; bases: more cities (M7_LAYOUT.md)
bases=1
; cities: city count C, 42..210; the data directory must be built for the same C
cities=210
; move: per-weapon movement and terrain costs (M12_MOVE.md): roads / bridges and ships faster, fords (浅瀬) as slow as marsh, every other terrain
; keeps its hexes per turn. 0 (or no key) = Koei's values
move=1

; ---- optional (defaults shown)
; astar: A* (0x567520): 0 original, 1 binary heap (same results), 2 + 2x heuristic, 3 + search window
; astar=3
; astar_margin: mode 3: hexes searched around the box of the start and the goal
; astar_margin=100
; objlist_lock: serialize the 3D object manager's list edits (loader thread vs main thread)
; objlist_lock=1
; model_guard: skip the queued unit model rebuild (0x5a03e0) for units that no longer have a model
; model_guard=1
; fast_clear: clear only the HEX28 pages the previous search wrote
; fast_clear=1
; city_shapes: 3-hex / 1-hex new cities from city_shapes.bin in data_dir (M11_MAP.md); without the file, or with 0,
; every city keeps Koei's 7 hexes
; city_shapes=1
; city_scale_mid / city_scale_small: model scale of tier 2 (3-hex) and tier 3 (1-hex) cities
; city_scale_mid=0.75
; city_scale_small=0.5
; move_w0..move_w11: with move=1, replace the built-in values of one weapon (0 剣 1 槍 2 戟 3 弩 4 軍馬 5 衝車 6 井闌
; 7 投石 8 木獣 9 走舸 10 楼船 11 闘艦): "<movement or - to keep>;<terrain>:<cost>,..." (movement 1..34, ships 1..51;
; terrain 0..21, cost 1..255, 255 = impassable). Terrains and costs not listed keep Koei's value. Built-in values
; (M12_MOVE.md):
; move_w0=20;10:3,12:3,13:8
; move_w1=20;10:3,12:3,13:8      (move_w2, move_w3 the same)
; move_w4=30;0:6,2:6,5:11,10:3,12:3,13:8,19:11
; move_w5=20;1:6,13:8,16:5,17:5,18:5,19:11      (move_w6..move_w8 the same)
; move_w9=42;7:6,8:5
; move_w10=50;7:8,8:4      (move_w11 the same)
; move_steer_w9..move_steer_w11: with move=1, the costs of a ship whose unit has 操舵 (instead of +4 movement):
; "-;<terrain>:<cost>,..." on top of move_w<N>
; move_steer_w9=-;7:5,8:4
; move_steer_w10=-;7:7,8:3      (move_steer_w11 the same)
; move_transport_water: with move=1, a transport's base movement on water (instead of 走舸's), 1..38
; move_transport_water=31
; move_cap_ship: with move=1, the most hexes the movement range of a ship reaches in one turn (Koei: 10 for every
; unit; land units stay at 10), 10..25
; move_cap_ship=16
; move_shore_scale: with move=1, a step from a ship onto land (or from land onto water) costs the cost times this
; turn's movement / the other weapon's movement (rounded up), so landing / boarding keep the fraction of the turn; 0 = Koei's
; move_shore_scale=1
; trade: M13 trade (M13_TRADE.md): caravans are transport units, a price index per city and good, transit tax / robbery /
; interception, AI caravans, a TRAD block in saves, automation "trade ..." commands. Needs trade.bin in data_dir
; (python tools/trade_data.py --out <data_dir>\trade.bin) and bases=1 with the same city count. 0 (or no key) = nothing installed.
; trade=1
; trade_data=trade.bin
; caravans led by a temporary 商 officer (special officer slot): at most trade_temp_max at a time, and only while at
; least trade_temp_keep special slots stay free; trade_template: the officer copied for them (745: Koei's bandit leader)
; trade_temp_max=30
; trade_temp_keep=30
; trade_template=745
; AI caravans: monthly, at most trade_ai_month new ones, trade_ai_max per force, from a city with trade_ai_min_gold,
; investing up to trade_ai_invest (keeping trade_ai_reserve), to a city within trade_ai_range hexes, for at least
; trade_ai_margin percent profit; trade_ai_hook: the AI's unit planning (0x5def90) leaves caravans to trade.cpp
; trade_ai=1
; trade_ai_hook=1
; trade_ai_month=6
; trade_ai_max=2
; trade_ai_min_gold=6000
; trade_ai_invest=4000
; trade_ai_reserve=2000
; trade_ai_range=80
; trade_ai_margin=25
; prices: trade_impact percent change when a market takes / gives its size in loads, trade_spread between buy and sell,
; trade_revert / trade_revert_hub percent of the gap to the base price recovered a month
; trade_impact=50
; trade_spread=10
; trade_revert=10
; trade_revert_hub=25
; caravans: loads (both ends ports: trade_cap_sea), fee per caravan, escort troops and food of the transport unit,
; arrival distance to the destination city (hexes), turns before a caravan gives up
; trade_cap_land=20
; trade_cap_sea=60
; trade_fee=300
; trade_escort=500
; trade_food=3000
; trade_arrive=3
; trade_max_turns=90
; passing another force's city: allied free; friendliness >= trade_rel_tax pays trade_tax percent of the cargo's value
; there (hubs trade_tax_hub; the same as import duty at the destination); below it trade_rob percent chance to lose
; trade_rob_loss percent of the goods; a destroyed caravan gives trade_loot percent of its cargo's value to the victor
; trade_tax=10
; trade_tax_hub=5
; trade_rel_tax=40
; trade_rob=15
; trade_rob_loss=50
; trade_loot=60
; trade_player_auto: 1 = the player's caravans also move by themselves at the end of each turn (0: use 一括実行 / move them)
; trade_player_auto=0

; ---- debugging
; trace: which game code creates/draws Direct3D resources (worldmod_trace_<section>.log)
; trace=1
; diag: per-call Direct3D diagnostic lines in the main log (BIG DIP, Clear, SetRS, PROJ, ...); on with trace=1.
; Very verbose (thousands of lines per second): only for a short look
; diag=1
; heap_check: validate all heaps every 20 ms, log where the main/loader threads are when one breaks
; heap_check=1
; forces: regular forces (= regular corps), 42..249 and at most the city count (M8_FORCES.md); the data directory
; must be converted for the same count (convert_scen.py --forces, or "forces" in project.json)
; forces=200
; units: units (armies) on the map, 1000..30000 (M9_UNITS.md); saves made with fewer units still load
; units=5000
; persons: scenario officers (武将), 850..31750 (M10_PERSONS.md); all officers = persons + 250. Saves only load with
; the count they were made with; Koei's scenarios load with the extra officers empty
; persons=15000
; unit_first: debug (M9 tests): new units take the first free id from this one on, so ids beyond 1000 get used
; unit_first=4500
; getter_check: log gate / port getter calls with an out-of-range index and their call sites (missed id-boundary patches)
; getter_check=1
; astar_stats: log A* calls slower than 5 ms and a summary every 10 s
; astar_stats=1
; astar_verify: run the original A* as well and compare HEX28 byte for byte
; astar_verify=1
; astar_bench_slow: replay the first 10 slow A* calls with every mode and log the times
; astar_bench_slow=1
; watch_objlist: check the object lists every 50 ms (2: also make the list heads read-only and log stray writes)
; watch_objlist=1
; watch=<hex address>    ; hardware write watchpoint (watch_read=1: reads too)

; auto_skip: no launch movies (KOEI logo, opening movie; the "click the mouse" screen is clicked away) up to
; the title menu, and when a map appears (new game, loaded save) the opening events and dialogs are
; clicked through until the map is idle. It never holds the mouse; a real click, Enter, Space, Esc or a
; mouse move of more than 40 pixels stops it.
auto_skip=1

; san11pk_test.exe: a copy used for automated tests (tools/gamectl.py): fake mouse/keyboard, screenshots
; [san11pk_test]
; automation=1
; memlog=1   ; with automation=1: process memory + free address space in the log every 30 s (same as the "mem" command)
; ...same keys as [san11pk_world]
