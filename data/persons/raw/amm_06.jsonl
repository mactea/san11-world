{"name_en": "Severus (magister equitum)", "zh": "塞維魯", "sei": "塞", "mei": "維魯", "zh_full": "塞維魯斯（騎兵長官）", "sex": "m", "years": [356, 358], "birth": null, "death": null, "death_violent": false, "polity": "羅馬帝國", "role": "武将", "place": "蘭斯", "lat": 49.26, "lon": 4.03, "offices": ["騎兵長官"], "kin": [], "friends": ["Julian (emperor)"], "foes": ["Chnodomarius"], "bio": "久經行伍之將，君士坦提烏斯遣代馬塞盧斯掌高盧之軍。不驕不專，事尤利安如士卒事主將。斯特拉斯堡之戰統左翼，疑有伏兵而按兵不動；後於科隆道上遇法蘭克劫掠者，又沿河襲降薩利法蘭克人。其後渡萊茵河入阿勒曼尼境，忽然怯戰，脅迫嚮導詐稱不識路。", "stats": [76, 66, 62, 45, 58], "lean": "槍", "conf": "B", "src": "Ammianus 16.10-17.10"}
{"name_en": "Bainobaudes", "zh": "拜諾鮑德", "sei": "拜諾", "mei": "鮑德", "zh_full": "拜諾鮑德斯", "sex": "m", "years": [357, 357], "birth": null, "death": 357, "death_violent": true, "polity": "羅馬帝國", "role": "武将", "place": "斯特拉斯堡", "lat": 48.58, "lon": 7.75, "offices": ["角盔軍團保民官"], "kin": [], "friends": ["Julian (emperor)"], "foes": ["Chnodomarius"], "bio": "角盔軍團保民官。尤利安探知盛夏萊茵河可涉，遣其率輕裝輔兵涉淺、浮盾泅渡，登島盡殺蠻族，又奪空船襲掠諸島，滿載而歸，諸部遂棄島而走。斯特拉斯堡之戰陣亡。", "stats": [62, 75, 40, 30, 50], "lean": "槍", "conf": "B", "src": "Ammianus 16.11-12"}
{"name_en": "Cella", "zh": "凱拉", "sei": "凱", "mei": "拉", "zh_full": "凱拉", "sex": "m", "years": [357, 357], "birth": null, "death": null, "death_violent": false, "polity": "羅馬帝國", "role": "武将", "place": "奧古斯塔勞里卡", "lat": 47.53, "lon": 7.72, "offices": ["盾衛軍保民官"], "kin": [], "friends": ["Barbatio"], "foes": ["Valentinian I"], "bio": "盾衛軍保民官，以巴爾巴提奧副手從征。拉埃提人劫掠里昂而歸，凱拉禁止拜諾鮑德斯與瓦倫提尼安把守其歸路，致敵得以逃脫；事後被詰，自承其事。", "stats": [40, 45, 35, 25, 25], "lean": "無", "conf": "C", "src": "Ammianus 16.11"}
{"name_en": "Vestralpus", "zh": "韋斯特拉", "sei": "韋斯", "mei": "特拉", "zh_full": "韋斯特拉爾普斯", "sex": "m", "years": [357, 361], "birth": null, "death": null, "death_violent": false, "polity": "阿勒曼尼", "role": "外族首领", "place": "斯特拉斯堡", "lat": 48.58, "lon": 7.75, "offices": ["國王"], "kin": [], "friends": ["Chnodomarius"], "foes": ["Julian (emperor)"], "bio": "阿勒曼尼諸王之一。聞巴爾巴提奧敗退，與克諾多馬里烏斯、烏里烏斯等諸王合兵，進逼斯特拉斯堡，與尤利安決戰而敗。", "stats": [55, 62, 38, 35, 45], "lean": "騎", "conf": "C", "src": "Ammianus 16.12"}
{"name_en": "Serapio", "zh": "塞拉皮奧", "sei": "塞拉", "mei": "皮奧", "zh_full": "塞拉皮奧（阿格納里庫斯）", "sex": "m", "years": [357, 357], "birth": null, "death": null, "death_violent": false, "polity": "阿勒曼尼", "role": "外族首领", "place": "斯特拉斯堡", "lat": 48.58, "lon": 7.75, "offices": ["國王"], "kin": [{"rel": "父", "name": "Mederichus"}], "friends": ["Chnodomarius"], "foes": ["Julian (emperor)"], "bio": "阿勒曼尼國王，克諾多馬里烏斯之姪，梅德里庫斯之子。本名阿格納里庫斯，其父久為人質於高盧、習希臘秘儀，乃改其名為塞拉皮奧。年少而才過其齡，斯特拉斯堡之戰與其叔共為諸王之首，統右翼，戰敗。", "stats": [68, 70, 55, 40, 60], "lean": "騎", "conf": "B", "src": "Ammianus 16.12"}
{"name_en": "Mederichus", "zh": "梅德里克", "sei": "梅德", "mei": "里克", "zh_full": "梅德里庫斯", "sex": "m", "years": [357, 357], "birth": null, "death": null, "death_violent": false, "polity": "阿勒曼尼", "role": "外族首领", "place": "高盧", "lat": 48.5, "lon": 6.0, "offices": ["王族"], "kin": [{"rel": "兄", "name": "Chnodomarius"}, {"rel": "子", "name": "Serapio"}], "friends": [], "foes": [], "bio": "阿勒曼尼王族，克諾多馬里烏斯之弟，一生詭詐。久為人質於高盧，習得希臘秘儀，遂將其子阿格納里庫斯改名塞拉皮奧。", "stats": [40, 50, 50, 35, 35], "lean": "無", "conf": "C", "src": "Ammianus 16.12"}
