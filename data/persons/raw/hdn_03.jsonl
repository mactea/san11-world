{"name_en": "Barsemius", "zh": "巴爾塞米", "sei": "巴爾", "mei": "塞米", "zh_full": "巴爾塞米烏斯", "sex": "m", "years": [193, 199], "birth": null, "death": null, "death_violent": false, "polity": "哈特拉", "role": "外族首领", "place": "哈特拉", "lat": 35.59, "lon": 42.72, "offices": ["國王"], "kin": [], "friends": ["Pescennius Niger"], "foes": ["Septimius Severus"], "bio": "哈特拉國王。尼格爾起兵爭帝位，遣弓手助之。塞維魯平東方後，以其親附尼格爾為由親征，圍哈特拉山城。城中弓手拒守，擲毒蟲陶罐傷敵，羅馬軍疫病交加，塞維魯無功而退。", "stats": [68, 50, 62, 58, 62], "lean": "弩", "conf": "B", "src": "Herodian 3.1, 3.9"}
{"name_en": "Julius Laetus", "zh": "雷圖斯", "sei": "雷", "mei": "圖斯", "zh_full": "尤利烏斯·雷圖斯", "sex": "m", "years": [193, 198], "birth": null, "death": 198, "death_violent": true, "polity": "羅馬帝國", "role": "武将", "place": "盧格杜努姆", "lat": 45.76, "lon": 4.83, "offices": ["將軍"], "kin": [], "friends": [], "foes": ["Clodius Albinus", "Septimius Severus"], "bio": "塞維魯麾下將領。盧格杜努姆決戰時，塞維魯所部敗走墜馬，雷圖斯率生力軍方至，一舉擊潰阿爾比努斯軍。時人謂其按兵觀望、欲自取帝位。塞維魯事定後厚賞諸將，獨記恨殺之。", "stats": [76, 66, 64, 42, 55], "lean": "騎", "conf": "B", "src": "Herodian 3.7"}
