{"name_en": "Festus (freedman of Caracalla)", "zh": "費斯圖斯", "sei": "費斯", "mei": "圖斯", "zh_full": "費斯圖斯", "sex": "m", "years": [214, 214], "birth": null, "death": 214, "death_violent": false, "polity": "羅馬帝國", "role": "文臣", "place": "伊利昂", "lat": 39.96, "lon": 26.24, "offices": ["掌皇家記錄"], "kin": [], "friends": ["Caracalla"], "foes": [], "bio": "卡拉卡拉最寵愛的被釋奴，掌管皇家記錄。隨帝東巡至伊利昂而死，或言被毒殺。卡拉卡拉仿阿基里斯葬帕特羅克洛斯之例，積柴焚其屍，殺牲酹酒，又欲剪髮投火，為眾所笑。", "stats": [15, 15, 50, 48, 40], "lean": "無", "conf": "C", "src": "Herodian 4.8"}
{"name_en": "Flavius Maternianus", "zh": "馬特尼安", "sei": "馬特", "mei": "尼安", "zh_full": "弗拉維烏斯·馬特尼亞努斯", "sex": "m", "years": [217, 217], "birth": null, "death": null, "death_violent": false, "polity": "羅馬帝國", "role": "文臣", "place": "羅馬", "lat": 41.9, "lon": 12.5, "offices": ["羅馬城留守"], "kin": [], "friends": ["Caracalla"], "foes": ["Macrinus"], "bio": "卡拉卡拉最信任的心腹，帝東征時總攬羅馬城事務。奉密令尋訪術士、問卜帝之壽命及有無謀叛者，遂上書告禁衛軍長官馬克里努斯謀反。書落入馬克里努斯之手，馬克里努斯懼，先發制人，使人刺殺卡拉卡拉。", "stats": [42, 38, 62, 60, 45], "lean": "無", "conf": "B", "src": "Herodian 4.12-4.13"}
