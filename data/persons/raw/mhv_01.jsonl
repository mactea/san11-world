{"name_en": "Mahanaga (thera of Bhutarama)", "zh": "摩訶那伽", "sei": "摩訶", "mei": "那伽", "zh_full": "部多園的摩訶那伽長老", "sex": "m", "years": [167, 186], "birth": null, "death": null, "death_violent": false, "polity": "錫蘭佛教", "role": "宗教", "place": "阿努拉德普勒", "lat": 8.35, "lon": 80.4, "offices": ["長老"], "kin": [], "friends": ["Kanittha Tissa"], "foes": [], "bio": "居部多園的長老。卡尼塔·帝須王甚敬重之，特為他在無畏山寺興建華美的寶殿（Ratanapasada），以示供養。", "stats": [12, 10, 62, 40, 65], "lean": "無", "conf": "C", "src": "Mahavamsa 36.7"}
{"name_en": "Deva (thera of Kappukagama)", "zh": "提婆", "sei": "提", "mei": "婆", "zh_full": "迦布迦村的提婆長老", "sex": "m", "years": [209, 231], "birth": null, "death": null, "death_violent": false, "polity": "錫蘭佛教", "role": "宗教", "place": "阿努拉德普勒", "lat": 8.35, "lon": 80.4, "offices": ["長老"], "kin": [], "friends": ["Voharika Tissa"], "foes": [], "bio": "居迦布迦村的長老。沃哈里卡·帝須王聽其說法而生信心，遂修復五處佛教建築。", "stats": [10, 10, 60, 38, 58], "lean": "無", "conf": "C", "src": "Mahavamsa 36.30"}
{"name_en": "Mahatissa (thera of Anurarama)", "zh": "摩訶帝須", "sei": "摩訶", "mei": "帝須", "zh_full": "阿努羅園的摩訶帝須長老", "sex": "m", "years": [209, 231], "birth": null, "death": null, "death_violent": false, "polity": "錫蘭佛教", "role": "宗教", "place": "阿努拉德普勒", "lat": 8.35, "lon": 80.4, "offices": ["長老"], "kin": [], "friends": ["Voharika Tissa"], "foes": [], "bio": "居阿努羅園的長老。沃哈里卡·帝須王對其甚為滿意，為他在穆遮羅港設齋布施。", "stats": [10, 10, 58, 38, 56], "lean": "無", "conf": "C", "src": "Mahavamsa 36.31"}
{"name_en": "Kapila (minister of Voharika Tissa)", "zh": "迦毗羅", "sei": "迦", "mei": "毗羅", "zh_full": "迦毗羅", "sex": "m", "years": [209, 231], "birth": null, "death": null, "death_violent": false, "polity": "阿努拉德普勒王國", "role": "文臣", "place": "阿努拉德普勒", "lat": 8.35, "lon": 80.4, "offices": ["大臣"], "kin": [], "friends": ["Voharika Tissa"], "foes": [], "bio": "沃哈里卡·帝須王的大臣。奉王命壓制方廣（Vetulya）異說、約束外道，使上座部正法重光。", "stats": [35, 30, 62, 66, 45], "lean": "無", "conf": "C", "src": "Mahavamsa 36.41"}
{"name_en": "Subhadeva", "zh": "須婆提婆", "sei": "須婆", "mei": "提婆", "zh_full": "須婆提婆", "sex": "m", "years": [228, 231], "birth": null, "death": null, "death_violent": false, "polity": "阿努拉德普勒王國", "role": "謀士", "place": "阿努拉德普勒", "lat": 8.35, "lon": 80.4, "offices": [], "kin": [{"rel": "外甥", "name": "Abhaya Naga"}], "friends": ["Abhaya Naga"], "foes": ["Voharika Tissa"], "bio": "阿婆耶那伽的舅父。阿婆耶那伽私通王后事敗出奔，佯怒斬其手足，留之國中。須婆提婆偽投沃哈里卡·帝須王，暗中離間君臣。使者來探，他以矛松動檳榔樹根，一臂推倒以示時機已熟，阿婆耶那伽遂率泰米爾兵回師奪位。", "stats": [40, 35, 78, 50, 40], "lean": "無", "conf": "B", "src": "Mahavamsa 36.42"}
{"name_en": "Mahadeva (thera of Damahalaka)", "zh": "摩訶提婆", "sei": "摩訶", "mei": "提婆", "zh_full": "達摩訶羅迦的摩訶提婆長老", "sex": "m", "years": [243, 247], "birth": null, "death": null, "death_violent": false, "polity": "錫蘭佛教", "role": "宗教", "place": "阿努拉德普勒", "lat": 8.35, "lon": 80.4, "offices": ["長老"], "kin": [], "friends": ["Sangha Tissa I"], "foes": [], "bio": "居達摩訶羅迦的長老。僧伽帝須王聽他講說施粥功德之經，歡喜信受，於城四門向僧眾大施米粥。", "stats": [10, 10, 60, 38, 56], "lean": "無", "conf": "C", "src": "Mahavamsa 36.66"}
{"name_en": "Gothabhaya (thera)", "zh": "瞿塔婆耶", "sei": "瞿塔", "mei": "婆耶", "zh_full": "僧護院的瞿塔婆耶長老", "sex": "m", "years": [249, 262], "birth": null, "death": null, "death_violent": false, "polity": "錫蘭佛教", "role": "宗教", "place": "阿努拉德普勒", "lat": 8.35, "lon": 80.4, "offices": ["長老"], "kin": [{"rel": "外甥", "name": "Gothabhaya of Anuradhapura"}], "friends": ["Gothabhaya of Anuradhapura"], "foes": ["Sanghamitta (Chola monk)"], "bio": "居僧護院的長老，哥塔巴耶王的母舅，曾以王的舊名稱呼國王。朱羅僧人僧伽蜜多闖入塔園集會，駁倒其說，自此得寵於王宮。", "stats": [12, 10, 60, 40, 55], "lean": "無", "conf": "C", "src": "Mahavamsa 36.112"}
{"name_en": "Sanghamitta (Chola monk)", "zh": "僧伽蜜多", "sei": "僧伽", "mei": "蜜多", "zh_full": "僧伽蜜多", "sex": "m", "years": [255, 280], "birth": null, "death": null, "death_violent": true, "polity": "錫蘭佛教", "role": "宗教", "place": "阿努拉德普勒", "lat": 8.35, "lon": 80.4, "offices": ["王師"], "kin": [], "friends": ["Mahasena of Anuradhapura", "Sona (minister of Mahasena)", "Gothabhaya of Anuradhapura"], "foes": ["Jettha Tissa I", "Gothabhaya (thera)", "Meghavannabhaya"], "bio": "朱羅國僧人，通驅鬼之術，敵視大寺派。駁倒瞿塔婆耶長老，得哥塔巴耶王寵信，受託教導二王子，偏愛摩訶斯那。傑塔帝須即位時懼禍出奔，後回國為摩訶斯那灌頂，勸王禁供大寺僧，拆毀銅殿移建無畏山寺。終為王所寵一妃遣人刺殺於塔園。", "stats": [20, 15, 80, 62, 72], "lean": "無", "conf": "B", "src": "Mahavamsa 37.1"}
{"name_en": "Sona (minister of Mahasena)", "zh": "蘇那", "sei": "蘇", "mei": "那", "zh_full": "蘇那", "sex": "m", "years": [274, 280], "birth": null, "death": null, "death_violent": true, "polity": "阿努拉德普勒王國", "role": "文臣", "place": "阿努拉德普勒", "lat": 8.35, "lon": 80.4, "offices": ["大臣"], "kin": [], "friends": ["Sanghamitta (Chola monk)", "Mahasena of Anuradhapura"], "foes": ["Meghavannabhaya"], "bio": "摩訶斯那王的寵臣，僧伽蜜多的追隨者，為人殘忍。率無恥僧人拆毀七層銅殿，將大寺諸建築材料搬往無畏山寺。僧伽蜜多被刺後，亦一同被殺。", "stats": [40, 50, 45, 50, 30], "lean": "無", "conf": "B", "src": "Mahavamsa 37.9"}
{"name_en": "Meghavannabhaya", "zh": "彌伽婆耶", "sei": "彌伽", "mei": "婆耶", "zh_full": "彌伽婆那阿婆耶", "sex": "m", "years": [274, 285], "birth": null, "death": null, "death_violent": false, "polity": "阿努拉德普勒王國", "role": "武将", "place": "阿努拉德普勒", "lat": 8.35, "lon": 80.4, "offices": ["大臣"], "kin": [], "friends": ["Mahasena of Anuradhapura"], "foes": ["Sanghamitta (Chola monk)", "Sona (minister of Mahasena)"], "bio": "摩訶斯那王的摯友，總攬王的諸般事務。憤王毀大寺，入摩羅耶起兵，屯於杜羅帝須池。夜攜酒肉獨赴王營，與王共食，直言起兵之由，王許復興大寺，二人和好。後運回建材，在大寺重建數座僧院，使僧眾重歸。", "stats": [70, 62, 68, 72, 78], "lean": "無", "conf": "B", "src": "Mahavamsa 37.18"}
{"name_en": "Tissa (thera of Dakkhinarama)", "zh": "帝須", "sei": "帝", "mei": "須", "zh_full": "南園的帝須長老", "sex": "m", "years": [274, 301], "birth": null, "death": null, "death_violent": false, "polity": "錫蘭佛教", "role": "宗教", "place": "阿努拉德普勒", "lat": 8.35, "lon": 80.4, "offices": ["長老"], "kin": [], "friends": ["Mahasena of Anuradhapura"], "foes": [], "bio": "居南園的長老，被史家斥為偽善陰謀之徒。摩訶斯那王不聽勸阻，在大寺界內光明園為他建祇陀林寺。後被控犯波羅夷重罪，執法大臣不顧王意，依律將他逐出僧團。", "stats": [15, 10, 65, 45, 50], "lean": "無", "conf": "B", "src": "Mahavamsa 37.32"}
