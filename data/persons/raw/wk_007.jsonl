{"i": 426, "title": "Heliodorus of Altino", "qid": "Q2697454", "skip": "", "zh": "赫利奧多", "sei": "赫利", "mei": "奧多", "zh_full": "阿爾蒂諾的赫利奧多羅斯", "sex": "m", "birth": null, "death": 390, "death_violent": false, "polity": "羅馬教會", "role": "宗教", "place": "阿爾蒂諾", "lat": 45.55, "lon": 12.4, "offices": ["阿爾蒂諾主教"], "kin": [{"rel": "姪", "qid": "", "name": "Nepotianus"}], "friends": ["Jerome", "Chromatius", "Valerianus of Aquileia"], "foes": [], "bio": "生於達爾馬提亞，與克羅馬提烏斯同為阿奎萊亞主教瓦勒里亞努斯門下。曾隨哲羅姆赴聖地，見於哲羅姆書信。母歿後赴義大利，為阿爾蒂諾首任主教，抵制亞流派，出席381年阿奎萊亞會議，並授其姪內波提亞努斯聖職。", "stats": [15, 10, 60, 50, 55], "lean": "無", "known": true}
