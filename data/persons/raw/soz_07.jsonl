{"name_en": "Uranius of Tyre", "zh": "烏拉紐", "sei": "烏", "mei": "拉紐", "zh_full": "推羅的烏拉紐斯", "sex": "m", "years": [357, 360], "birth": null, "death": null, "death_violent": false, "polity": "阿里烏派", "role": "宗教", "place": "推羅", "lat": 33.27, "lon": 35.2, "offices": ["推羅主教"], "kin": [], "friends": ["Eudoxius of Antioch", "Acacius of Caesarea"], "foes": ["Basil of Ancyra"], "bio": "推羅主教，阿里烏派。歐多克修斯據安條克主教之位後，與凱撒利亞的阿卡修斯等同黨會於安條克，既棄「本質相似」，亦廢「本質同一」之說，託言西方主教已有此議，並致書瓦倫斯、烏爾薩修、格爾米尼烏斯致謝。", "stats": [16, 12, 58, 52, 45], "lean": "無", "conf": "B", "src": "Sozomen 4.12"}
{"name_en": "Leontius (presbyter, former chamberlain)", "zh": "萊昂提", "sei": "萊", "mei": "昂提", "zh_full": "長老萊昂提烏斯", "sex": "m", "years": [358, 358], "birth": null, "death": null, "death_violent": false, "polity": "羅馬教會", "role": "宗教", "place": "安卡拉", "lat": 39.93, "lon": 32.86, "offices": ["長老", "前宮廷寢官"], "kin": [], "friends": ["Basil of Ancyra", "Eustathius of Sebaste", "Eleusius of Cyzicus"], "foes": ["Eudoxius of Antioch", "Aëtius of Antioch"], "bio": "原為皇帝寢宮侍從，後為長老。安卡拉會議揭發歐多克修斯之異說，推舉巴西爾、歐斯塔修、埃勒烏修斯與萊昂提烏斯為使赴宮廷，君士坦提烏斯遂定歐多克修斯一黨之罪。", "stats": [15, 12, 50, 48, 45], "lean": "無", "conf": "C", "src": "Sozomen 4.13"}
{"name_en": "Asphalius", "zh": "阿斯法", "sei": "阿", "mei": "斯法", "zh_full": "阿斯法利烏斯", "sex": "m", "years": [358, 358], "birth": null, "death": null, "death_violent": false, "polity": "阿里烏派", "role": "宗教", "place": "安條克", "lat": 36.2, "lon": 36.16, "offices": ["長老"], "kin": [], "friends": ["Eudoxius of Antioch", "Aëtius of Antioch"], "foes": ["Basil of Ancyra"], "bio": "安條克長老，極力鼓吹埃提烏斯之異說。已在宮中得君士坦提烏斯書信，正欲啟程，適逢安卡拉使團至，揭發其黨之異端，皇帝遂追回所賜書信，另頒詔書斥逐歐多克修斯一黨。", "stats": [12, 12, 48, 40, 38], "lean": "無", "conf": "C", "src": "Sozomen 4.13"}
{"name_en": "Eleusius of Cyzicus", "zh": "埃勒烏", "sei": "埃", "mei": "勒烏", "zh_full": "西齊庫斯的埃勒烏修斯", "sex": "m", "years": [356, 381], "birth": null, "death": null, "death_violent": false, "polity": "羅馬教會", "role": "宗教", "place": "西齊庫斯", "lat": 40.38, "lon": 27.88, "offices": ["西齊庫斯主教"], "kin": [], "friends": ["Basil of Ancyra", "Eustathius of Sebaste", "Macedonius I of Constantinople"], "foes": ["Eudoxius of Antioch", "Aëtius of Antioch"], "bio": "西齊庫斯主教，主「本質相似」之說。安卡拉會議推為使臣，與巴西爾、歐斯塔修同赴宮廷，揭發歐多克修斯、埃提烏斯之說。在西爾米烏姆深得君士坦提烏斯信用，與巴西爾等迫利伯略簽署信條。", "stats": [18, 12, 65, 58, 55], "lean": "無", "conf": "B", "src": "Sozomen 4.13"}
{"name_en": "Gaius of Sabaria", "zh": "蓋烏斯", "sei": "蓋", "mei": "烏斯", "zh_full": "薩巴里亞的蓋烏斯", "sex": "m", "years": [355, 360], "birth": null, "death": null, "death_violent": false, "polity": "阿里烏派", "role": "宗教", "place": "西爾米烏姆", "lat": 47.23, "lon": 16.62, "offices": ["薩巴里亞主教"], "kin": [], "friends": ["Valens of Mursa", "Ursacius of Singidunum", "Germinius of Sirmium", "Auxentius of Milan"], "foes": [], "bio": "潘諾尼亞薩巴里亞主教，阿里烏派。里米尼會議上與瓦倫斯、烏爾薩修、格爾米尼烏斯、奧克森提烏斯、德摩菲盧斯同倡西爾米烏姆信條，拒絕詛咒阿里烏之說，被會議斥為製造紛爭之徒而革除。", "stats": [14, 12, 52, 45, 40], "lean": "無", "conf": "C", "src": "Sozomen 4.17"}
