{"name_en": "Anicetus (praetorian prefect)", "zh": "阿尼凱圖", "sei": "阿尼", "mei": "凱圖", "zh_full": "阿尼凱圖斯", "sex": "m", "years": [350, 350], "birth": null, "death": null, "death_violent": false, "polity": "羅馬帝國", "role": "武将", "place": "羅馬", "lat": 41.9, "lon": 12.5, "offices": ["禁衛軍長官"], "kin": [], "friends": ["Magnentius"], "foes": ["Nepotianus"], "bio": "馬格嫩提烏斯所任禁衛軍長官。內波提亞努斯糾集亡命之徒稱帝攻羅馬，阿尼凱圖斯武裝城中平民出城迎戰；民兵不習戰陣，一觸即潰。阿尼凱圖斯恐城有失，閉門不納，潰兵無路可逃，盡為敵所殺。", "stats": [42, 40, 45, 45, 35], "lean": "無", "conf": "B", "src": "Zosimus 2.43"}
{"name_en": "Fabius Titianus", "zh": "提提安", "sei": "提", "mei": "提安", "zh_full": "法比烏斯·提提亞努斯", "sex": "m", "years": [351, 351], "birth": null, "death": null, "death_violent": false, "polity": "羅馬帝國", "role": "文臣", "place": "羅馬", "lat": 41.9, "lon": 12.5, "offices": ["元老"], "kin": [], "friends": ["Magnentius"], "foes": ["Constantius II"], "bio": "羅馬元老。奉馬格嫩提烏斯之命至君士坦提烏斯二世營中，傳其傲慢之辭，歷數君士坦丁父子之罪，歸城邑殘破於其失政，令君士坦提烏斯讓位於馬格嫩提烏斯以求苟全。君士坦提烏斯祈神明為君士坦斯復仇，放其歸還。", "stats": [25, 25, 62, 65, 55], "lean": "無", "conf": "B", "src": "Zosimus 2.49"}
{"name_en": "Manadus", "zh": "馬納杜斯", "sei": "馬納", "mei": "杜斯", "zh_full": "馬納杜斯", "sex": "m", "years": [351, 351], "birth": null, "death": null, "death_violent": false, "polity": "羅馬帝國", "role": "武将", "place": "穆爾薩", "lat": 45.55, "lon": 18.68, "offices": ["軍團長"], "kin": [], "friends": ["Scudilo", "Constantius II"], "foes": ["Magnentius"], "bio": "君士坦提烏斯二世麾下軍團長。穆爾薩之戰前，馬格嫩提烏斯伏高盧兵四隊於城前林木環繞之競技場，欲夾擊敵軍，為城上守軍所察。君士坦提烏斯遣其與斯庫迪洛精選重步兵與弓手，閉場中諸門，據上層看台四面射殺，伏兵盡殲。", "stats": [66, 62, 55, 35, 45], "lean": "弩", "conf": "B", "src": "Zosimus 2.50"}
{"name_en": "Arcadius (commander of the Abulci)", "zh": "阿卡狄烏", "sei": "阿卡", "mei": "狄烏", "zh_full": "阿卡狄烏斯", "sex": "m", "years": [351, 351], "birth": null, "death": 351, "death_violent": true, "polity": "羅馬帝國", "role": "武将", "place": "穆爾薩", "lat": 45.55, "lon": 18.68, "offices": ["阿布爾基軍團長"], "kin": [], "friends": [], "foes": [], "bio": "統阿布爾基軍團。穆爾薩之戰，兩軍自晝鏖戰至深夜，諸將皆身先士卒，阿卡狄烏斯力戰陣亡。", "stats": [60, 62, 40, 30, 40], "lean": "無", "conf": "C", "src": "Zosimus 2.51"}
{"name_en": "Menelaus (archer)", "zh": "梅內勞斯", "sei": "梅內", "mei": "勞斯", "zh_full": "梅內勞斯", "sex": "m", "years": [351, 351], "birth": null, "death": 351, "death_violent": true, "polity": "羅馬帝國", "role": "武将", "place": "穆爾薩", "lat": 45.55, "lon": 18.68, "offices": ["亞美尼亞騎射手統領"], "kin": [], "friends": ["Constantius II"], "foes": ["Romulus (general of Magnentius)", "Magnentius"], "bio": "君士坦提烏斯二世麾下亞美尼亞騎射手統領。相傳能一弦同發三矢，各中一敵，於穆爾薩之戰中射殺敵兵甚眾，幾使敵軍潰走。終為馬格嫩提烏斯全軍統帥羅慕路斯所殺。", "stats": [62, 86, 40, 25, 52], "lean": "騎", "conf": "B", "src": "Zosimus 2.51-52"}
