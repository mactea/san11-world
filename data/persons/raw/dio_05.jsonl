{"name_en": "Claudius (robber)", "zh": "克勞狄", "sei": "克", "mei": "勞狄", "zh_full": "克勞狄烏斯", "sex": "m", "years": [195, 195], "birth": null, "death": null, "death_violent": false, "polity": "羅馬帝國", "role": "叛军首领", "place": "猶太", "lat": 31.8, "lon": 35.2, "offices": ["盜魁"], "kin": [], "friends": [], "foes": ["Septimius Severus"], "bio": "盜賊首領，橫行猶太、敘利亞，官軍追捕甚急。塞維魯駐尼西比斯時，克勞狄竟率數騎，假作軍團長官來謁，向皇帝致禮行吻，從容而去，當時無人識破，事後亦終未就擒。", "stats": [55, 70, 62, 10, 48], "lean": "騎", "conf": "B", "src": "Dio 75.2"}
{"name_en": "Probus (general of Severus)", "zh": "普羅布斯", "sei": "普羅", "mei": "布斯", "zh_full": "普羅布斯", "sex": "m", "years": [195, 195], "birth": null, "death": null, "death_violent": false, "polity": "羅馬帝國", "role": "武将", "place": "美索不達米亞", "lat": 37.07, "lon": 41.22, "offices": ["將領"], "kin": [], "friends": ["Septimius Severus", "Julius Laetus", "Publius Cornelius Anullinus"], "foes": [], "bio": "塞維魯部將。塞維魯東征奧斯若恩、阿迪亞貝尼諸蠻，分軍為三，命萊圖斯、阿努利努斯與普羅布斯各領一軍，進攻一地，三路並進，雖頗艱難，終平之。", "stats": [62, 58, 45, 35, 40], "lean": "無", "conf": "B", "src": "Dio 75.3"}
{"name_en": "Numerianus (schoolmaster)", "zh": "努梅里安", "sei": "努梅", "mei": "里安", "zh_full": "努梅里亞努斯", "sex": "m", "years": [196, 197], "birth": null, "death": null, "death_violent": false, "polity": "羅馬帝國", "role": "其他", "place": "高盧", "lat": 45.76, "lon": 4.84, "offices": [], "kin": [], "friends": ["Septimius Severus"], "foes": ["Clodius Albinus"], "bio": "羅馬一蒙學教師。往高盧，詐稱塞維魯所遣元老，募兵討阿爾比努斯，殺其騎兵數人。塞維魯信以為真，致書嘉勉，令其增兵。努梅里安屢有奇功，曾截得七千萬塞斯特斯解送塞維魯。戰後自陳實情，不受官爵財賞，歸隱鄉間，僅受少許俸給度日。", "stats": [60, 45, 70, 30, 62], "lean": "無", "conf": "B", "src": "Dio 75.5"}
{"name_en": "Julius Crispus", "zh": "克里斯普", "sei": "克里", "mei": "斯普", "zh_full": "尤利烏斯·克里斯普斯", "sex": "m", "years": [198, 198], "birth": null, "death": 198, "death_violent": true, "polity": "羅馬帝國", "role": "武将", "place": "哈特拉", "lat": 35.59, "lon": 42.72, "offices": ["禁衛軍軍團長"], "kin": [], "friends": [], "foes": ["Septimius Severus"], "bio": "禁衛軍軍團長。塞維魯東征哈特拉，克里斯普痛戰禍之慘，偶誦維吉爾詩句：「為使圖努斯娶拉維尼亞，我輩徒然死去。」為士兵瓦萊里烏斯所告，塞維魯遂殺之。", "stats": [48, 45, 55, 40, 45], "lean": "無", "conf": "B", "src": "Dio 75.10"}
{"name_en": "Valerius (tribune)", "zh": "瓦萊里", "sei": "瓦", "mei": "萊里", "zh_full": "瓦萊里烏斯", "sex": "m", "years": [198, 198], "birth": null, "death": null, "death_violent": false, "polity": "羅馬帝國", "role": "武将", "place": "哈特拉", "lat": 35.59, "lon": 42.72, "offices": ["禁衛軍軍團長"], "kin": [], "friends": ["Septimius Severus"], "foes": ["Julius Crispus"], "bio": "塞維魯軍中士兵。告發禁衛軍軍團長克里斯普斯誦詩怨戰，克里斯普斯遂被殺，塞維魯即以瓦萊里烏斯代其職為軍團長。", "stats": [35, 50, 35, 20, 25], "lean": "無", "conf": "C", "src": "Dio 75.10"}
