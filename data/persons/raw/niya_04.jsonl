{"name_en": "Vasmana", "zh": "伐色摩那", "sei": "伐色", "mei": "摩那", "zh_full": "侍中天子大王伐色摩那", "sex": "m", "years": [318, 330], "birth": null, "death": null, "death_violent": false, "polity": "鄯善", "role": "君主", "place": "扜泥", "lat": 39.0, "lon": 88.0, "offices": ["大王", "天子", "侍中"], "kin": [], "friends": [], "foes": [], "bio": "鄯善國王，號「侍中天子大王」。在位第十年，自都城遣軍官古蘇羅俱舍那犀那等至精絕，發糧與羊供軍；在位第四年，准黎貝耶於精絕受地交租。文書多以其紀年。", "stats": [55, 40, 60, 65, 62], "lean": "無", "conf": "B", "src": "Niya Kh. 478"}
{"name_en": "Mahiri", "zh": "摩醯利", "sei": "摩", "mei": "醯利", "zh_full": "侍中天子大王摩醯利", "sex": "m", "years": [290, 318], "birth": null, "death": null, "death_violent": false, "polity": "鄯善", "role": "君主", "place": "扜泥", "lat": 39.0, "lon": 88.0, "offices": ["大王", "天子", "侍中"], "kin": [], "friends": ["Somjaka"], "foes": [], "bio": "鄯善國王，在位二十餘年。在位第十年，於御前與都城僧團為精絕僧團立規約，命長老尸羅波羅婆等主寺務，罰不赴布薩、著俗服、毆僧者以絹。其治下州長索闍伽審理收養、契約諸案。", "stats": [58, 40, 64, 70, 66], "lean": "無", "conf": "B", "src": "Niya Kh. 489"}
{"name_en": "Amgoka", "zh": "安歸迦", "sei": "安", "mei": "歸迦", "zh_full": "侍中天子大王安歸迦", "sex": "m", "years": [250, 290], "birth": null, "death": null, "death_violent": false, "polity": "鄯善", "role": "君主", "place": "扜泥", "lat": 39.0, "lon": 88.0, "offices": ["大王", "天子", "侍中"], "kin": [], "friends": ["Varpa", "Karamtsa"], "foes": [], "bio": "鄯善國王，在位三十餘年。在位第三十一年，命奧古、州長等於都城審理僧人奴婢逃亡案，交精絕僧團裁決。治下書吏蘭索支買地、庫尼他受田諸契皆以其紀年。", "stats": [62, 45, 65, 72, 68], "lean": "無", "conf": "B", "src": "Niya Kh. 506"}
{"name_en": "Pepiya", "zh": "白毗耶", "sei": "白", "mei": "毗耶", "zh_full": "天子大王白毗耶", "sex": "m", "years": [225, 250], "birth": null, "death": null, "death_violent": false, "polity": "鄯善", "role": "君主", "place": "扜泥", "lat": 39.0, "lon": 88.0, "offices": ["大王", "天子"], "kin": [], "friends": [], "foes": [], "bio": "鄯善國王。在位第八年，耶婆聚落居民阿布支羅賣地於迦利吉耶，以三歲馬為價，於法官稅監遮帝耶、督軍毗帝耶前立約，契書以其紀年。", "stats": [50, 40, 55, 60, 55], "lean": "無", "conf": "C", "src": "Niya Kh. 495"}
{"name_en": "Lyipeya", "zh": "黎貝耶", "sei": "黎", "mei": "貝耶", "zh_full": "州長黎貝耶", "sex": "m", "years": [300, 330], "birth": null, "death": null, "death_violent": false, "polity": "鄯善", "role": "文臣", "place": "精絕", "lat": 37.98, "lon": 82.72, "offices": ["州長", "稅監"], "kin": [], "friends": ["Kranaya", "Pumnavamta"], "foes": [], "bio": "精絕州長，亦任稅監。曾受地交租；與州長克羅那耶聯名，命阿布蘇奧布吉耶、稅官迦斯吉耶等將普尼官吏、居士、僧人即日帶到，違者笞五十；又遣斥候防備蘇毗人，向大州長檀闍伽稟報。", "stats": [45, 35, 55, 62, 50], "lean": "無", "conf": "B", "src": "Niya Kh. 554"}
{"name_en": "Kranaya", "zh": "克羅那耶", "sei": "克羅", "mei": "那耶", "zh_full": "州長克羅那耶", "sex": "m", "years": [300, 330], "birth": null, "death": null, "death_violent": false, "polity": "鄯善", "role": "文臣", "place": "精絕", "lat": 37.98, "lon": 82.72, "offices": ["州長"], "kin": [], "friends": ["Lyipeya"], "foes": [], "bio": "精絕州長。致書同僚黎貝耶，言蘇毗人來犯可懼，請速遣邊哨；又與黎貝耶聯名下令，將普尼眾官吏、僧侶、婆羅門即日帶到。巴拉蘇羅曾向其稟報田地租佃事。", "stats": [48, 38, 52, 58, 48], "lean": "無", "conf": "B", "src": "Niya Kh. 515"}
{"name_en": "Somjaka", "zh": "索闍伽", "sei": "索", "mei": "闍伽", "zh_full": "州長索闍伽", "sex": "m", "years": [295, 310], "birth": null, "death": null, "death_violent": false, "polity": "鄯善", "role": "文臣", "place": "精絕", "lat": 37.98, "lon": 82.72, "offices": ["州長"], "kin": [], "friends": ["Mahiri"], "foes": [], "bio": "摩醯利王時精絕州長。與探子奧布吉耶、利布他審理訟案，判定蘇摩那羅為庫尼他養子，不得為奴、不得賣押；又以其印封蘇古他受羊之契，文書多鈐其印。", "stats": [45, 35, 58, 66, 52], "lean": "無", "conf": "B", "src": "Niya Kh. 569"}
{"name_en": "Tamjaka", "zh": "檀闍伽", "sei": "檀", "mei": "闍伽", "zh_full": "大州長檀闍伽", "sex": "m", "years": [300, 330], "birth": null, "death": null, "death_violent": false, "polity": "鄯善", "role": "文臣", "place": "精絕", "lat": 37.98, "lon": 82.72, "offices": ["大州長"], "kin": [], "friends": ["Lyipeya"], "foes": [], "bio": "鄯善大州長。蘇古他與斯伐迦爭地毯與穀物，於其前撤誓和解；稅監黎貝耶遣斥候防備蘇毗，向其稟報軍情。", "stats": [50, 38, 55, 62, 52], "lean": "無", "conf": "B", "src": "Niya Kh. 541"}
{"name_en": "Bhimasena", "zh": "毗摩犀那", "sei": "毗摩", "mei": "犀那", "zh_full": "州長毗摩犀那", "sex": "m", "years": [290, 330], "birth": null, "death": null, "death_violent": false, "polity": "鄯善", "role": "文臣", "place": "精絕", "lat": 37.98, "lon": 82.72, "offices": ["州長", "奧古", "瓦蘇", "蘇伐他"], "kin": [], "friends": ["Dhapaya"], "foes": [], "bio": "精絕要員，歷任瓦蘇、奧古、州長。曾奏報逃往耶婆聚落之人應歸精絕服役；與奧古達帕耶等審理駱駝爭訟；僧人達摩毗利耶將駱駝交付於他；又奏其奴歐布格在外十年不歸。", "stats": [48, 38, 56, 64, 52], "lean": "無", "conf": "B", "src": "Niya Kh. 570"}
{"name_en": "Casgeya", "zh": "迦斯吉耶", "sei": "迦斯", "mei": "吉耶", "zh_full": "稅官迦斯吉耶", "sex": "m", "years": [300, 330], "birth": null, "death": null, "death_violent": false, "polity": "鄯善", "role": "文臣", "place": "精絕", "lat": 37.98, "lon": 82.72, "offices": ["稅官", "王家馬牧官"], "kin": [], "friends": ["Lyipeya", "Kranaya", "Pumnavamta"], "foes": [], "bio": "精絕稅官，又為王家馬牧官。屢受州長黎貝耶、克羅那耶及遮羅衍那富那伐檀之命徵集人丁、押送犯人；曾奏所託母馬被借去獵鹿致死；又受託代索羊隻、駱駝。", "stats": [40, 40, 45, 52, 42], "lean": "無", "conf": "B", "src": "Niya Kh. 517"}
{"name_en": "Pumnavamta", "zh": "富那伐檀", "sei": "富那", "mei": "伐檀", "zh_full": "遮羅衍那富那伐檀", "sex": "m", "years": [318, 330], "birth": null, "death": null, "death_violent": false, "polity": "鄯善", "role": "武将", "place": "精絕", "lat": 37.98, "lon": 82.72, "offices": ["遮羅衍那"], "kin": [], "friends": ["Lyipeya", "Kusanasena"], "foes": [], "bio": "鄯善軍官，伐色摩那王第十年隨古蘇羅俱舍那犀那率軍自都城至精絕受糧。後與州長黎貝耶聯名命稅官迦斯吉耶如數集齊人丁，不足者同罰。", "stats": [58, 55, 45, 45, 45], "lean": "槍", "conf": "B", "src": "Niya Kh. 517"}
