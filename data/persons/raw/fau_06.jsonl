{"name_en": "Aghanayozan", "zh": "阿加奈", "sei": "阿加", "mei": "奈", "zh_full": "阿加奈約贊", "sex": "m", "years": [361, 361], "birth": null, "death": null, "death_violent": false, "polity": "薩珊波斯", "role": "武将", "place": "亞美尼亞", "lat": 39.96, "lon": 44.55, "offices": ["將軍"], "kin": [], "friends": ["Shapur II"], "foes": ["Vasak Mamikonian"], "bio": "帕拉夫族人，出阿沙克家。在沙普爾前自誇能入侵亞美尼亞，遂領大軍來攻。阿爾沙克王以諸侯悉歸瓦薩克節制迎戰，其軍被擊敗驅回波斯。", "stats": [55, 50, 35, 32, 42], "lean": "騎", "conf": "C", "src": "Faustus 4.38"}
{"name_en": "Boyekan", "zh": "博耶坎", "sei": "博", "mei": "耶坎", "zh_full": "博耶坎", "sex": "m", "years": [361, 361], "birth": null, "death": 361, "death_violent": true, "polity": "薩珊波斯", "role": "武将", "place": "塔夫雷什", "lat": 38.08, "lon": 46.29, "offices": ["大總督"], "kin": [], "friends": ["Shapur II"], "foes": ["Vasak Mamikonian"], "bio": "波斯大總督。率大軍入阿特羅帕特尼欲攻亞美尼亞，瓦薩克截擊，大破其軍，於塔夫雷什將其斬殺，並焚波斯王宮。", "stats": [58, 52, 38, 35, 38], "lean": "騎", "conf": "C", "src": "Faustus 4.39"}
{"name_en": "Vachagan (Persian satrap)", "zh": "瓦恰甘", "sei": "瓦", "mei": "恰甘", "zh_full": "瓦恰甘", "sex": "m", "years": [362, 362], "birth": null, "death": 362, "death_violent": true, "polity": "薩珊波斯", "role": "武将", "place": "亞美尼亞", "lat": 39.96, "lon": 44.55, "offices": ["總督"], "kin": [], "friends": ["Shapur II"], "foes": ["Vasak Mamikonian"], "bio": "波斯總督。率大軍侵入亞美尼亞。瓦薩克留阿爾沙克王於塔里溫堡，傾全軍突襲其營，將其斬殺，波斯軍死傷甚眾。", "stats": [55, 52, 35, 32, 35], "lean": "騎", "conf": "C", "src": "Faustus 4.40"}
