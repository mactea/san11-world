{"name_en": "Hermophilus", "zh": "赫莫菲", "sei": "赫", "mei": "莫菲", "zh_full": "赫莫菲盧斯", "sex": "m", "years": [200, 215], "birth": null, "death": null, "death_violent": false, "polity": "狄奧多都派", "role": "宗教", "place": "羅馬", "lat": 41.9, "lon": 12.5, "offices": [], "kin": [], "friends": ["Asclepiodotus (Theodotian)"], "foes": [], "bio": "羅馬嗣子說派人物，以校正為名擅改聖經，其抄本與阿斯克勒庇奧多圖斯、狄奧多圖斯所傳者皆不相合。", "stats": [10, 10, 55, 30, 30], "lean": "無", "conf": "C", "src": "Eusebius HE 5.28"}
{"name_en": "Apolloniades", "zh": "阿波羅尼", "sei": "阿波", "mei": "羅尼", "zh_full": "阿波羅尼阿德斯", "sex": "m", "years": [200, 215], "birth": null, "death": null, "death_violent": false, "polity": "狄奧多都派", "role": "宗教", "place": "羅馬", "lat": 41.9, "lon": 12.5, "offices": [], "kin": [], "friends": ["Hermophilus"], "foes": [], "bio": "羅馬嗣子說派人物，以校正為名擅改聖經。其最初抄本與經過第二次竄改的抄本互相比對，差異甚大，自身尚不能一致。", "stats": [10, 10, 50, 30, 30], "lean": "無", "conf": "C", "src": "Eusebius HE 5.28"}
{"name_en": "Paul of Antioch (heretic)", "zh": "保羅", "sei": "保", "mei": "羅", "zh_full": "安條克人保羅", "sex": "m", "years": [200, 203], "birth": null, "death": null, "death_violent": false, "polity": "羅馬教會", "role": "宗教", "place": "亞歷山大里亞", "lat": 31.2, "lon": 29.9, "offices": [], "kin": [], "friends": [], "foes": ["Origen"], "bio": "亞歷山大里亞著名異端，安條克人，被一富有貴婦收為養子供養。以口才吸引眾多異端與教內信徒聚集。少年俄利根寄居同處，卻始終不肯與他一同禱告。", "stats": [10, 10, 65, 35, 65], "lean": "無", "conf": "C", "src": "Eusebius HE 6.2"}
{"name_en": "Plutarch (martyr)", "zh": "普魯塔克", "sei": "普魯", "mei": "塔克", "zh_full": "亞歷山大的普魯塔克", "sex": "m", "years": [202, 206], "birth": null, "death": null, "death_violent": true, "polity": "羅馬教會", "role": "宗教", "place": "亞歷山大里亞", "lat": 31.2, "lon": 29.9, "offices": [], "kin": [{"rel": "弟", "name": "Pope Heraclas of Alexandria"}], "friends": ["Origen"], "foes": [], "bio": "俄利根所收第一位異教學生，赫拉克拉斯之兄。一生高潔，塞維魯迫害時殉道。俄利根陪伴其赴死，幾乎被同鄉以為致死之由而打死。", "stats": [10, 15, 55, 30, 55], "lean": "無", "conf": "B", "src": "Eusebius HE 6.3; 6.4"}
