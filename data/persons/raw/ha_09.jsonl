{"name_en": "Heraclammon", "zh": "赫拉克蒙", "sei": "赫拉", "mei": "克蒙", "zh_full": "赫拉克拉蒙", "sex": "m", "years": [272, 272], "birth": null, "death": 272, "death_violent": true, "polity": "羅馬帝國", "role": "其他", "place": "提亞納", "lat": 37.83, "lon": 34.6, "offices": [], "kin": [], "friends": [], "foes": ["Aurelian"], "bio": "提亞納富人。奧勒良圍城，揚言城中不留一犬，赫拉克拉蒙懼死，指示城外天然土丘可登之處，城遂陷。奧勒良不喜叛國之徒，任士卒殺之，然將其家產歸還其子。", "stats": [18, 25, 52, 35, 22], "lean": "無", "conf": "B", "src": "HA Divus Aurelianus 22"}
{"name_en": "Cassius Longinus", "zh": "朗吉努", "sei": "朗", "mei": "吉努", "zh_full": "卡西烏斯·朗吉努斯", "sex": "m", "years": [260, 273], "birth": null, "death": 273, "death_violent": true, "polity": "帕爾米拉", "role": "学者", "place": "帕爾米拉", "lat": 34.55, "lon": 38.27, "offices": ["王室教師"], "kin": [], "friends": ["Zenobia"], "foes": ["Aurelian"], "bio": "哲學家，芝諾比婭從其習希臘學問。帕爾米拉陷落，奧勒良誅戮女王左右謀主，以芝諾比婭拒降之傲書出自其謀，遂殺朗吉努斯，時人深以為憾。", "stats": [15, 10, 88, 65, 75], "lean": "無", "conf": "B", "src": "HA Divus Aurelianus 30"}
{"name_en": "Mucapor", "zh": "穆卡波", "sei": "穆", "mei": "卡波", "zh_full": "穆卡波爾", "sex": "m", "years": [272, 275], "birth": null, "death": null, "death_violent": false, "polity": "羅馬帝國", "role": "武将", "place": "帕爾米拉", "lat": 34.55, "lon": 38.27, "offices": ["將領"], "kin": [], "friends": ["Aurelian"], "foes": [], "bio": "奧勒良部將。奧勒良圍帕爾米拉，途中屢為敘利亞盜寇所擾，曾致書穆卡波爾，坦言此役艱難，人譏與婦人交兵，而敵勢實如對壯夫。", "stats": [55, 58, 40, 35, 40], "lean": "無", "conf": "C", "src": "HA Divus Aurelianus 26"}
{"name_en": "Mnestheus", "zh": "涅斯透", "sei": "涅", "mei": "斯透", "zh_full": "姆涅斯透斯", "sex": "m", "years": [275, 275], "birth": null, "death": 275, "death_violent": true, "polity": "羅馬帝國", "role": "文臣", "place": "色雷斯", "lat": 41.0, "lon": 28.0, "offices": ["機密祕書"], "kin": [], "friends": [], "foes": ["Aurelian"], "bio": "奧勒良之機密祕書，一說為其釋奴。奧勒良晚年嚴苛，為人所怨，以某事出言威嚇姆涅斯透斯，令其懷恨，奧勒良旋即遇害。", "stats": [20, 20, 62, 45, 30], "lean": "無", "conf": "B", "src": "HA Divus Aurelianus 36"}
{"name_en": "Faltonius Probus", "zh": "普羅布斯", "sei": "普羅", "mei": "布斯", "zh_full": "法爾托尼烏斯·普羅布斯", "sex": "m", "years": [275, 275], "birth": null, "death": null, "death_violent": false, "polity": "羅馬帝國", "role": "文臣", "place": "以弗所", "lat": 37.94, "lon": 27.34, "offices": ["亞細亞總督"], "kin": [], "friends": [], "foes": [], "bio": "奧勒良死後，元老院與軍隊互相推讓，六月無帝，各地長官一仍其舊，唯以法爾托尼烏斯·普羅布斯代阿雷利烏斯·富斯庫斯為亞細亞總督。", "stats": [30, 25, 52, 55, 45], "lean": "無", "conf": "C", "src": "HA Divus Aurelianus 40"}
