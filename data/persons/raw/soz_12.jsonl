{"name_en": "Aetius of Antioch", "zh": "埃提烏斯", "sei": "埃", "mei": "提烏斯", "zh_full": "安提阿的埃提烏斯", "sex": "m", "years": [350, 367], "birth": null, "death": 367, "death_violent": false, "polity": "阿里烏派", "role": "宗教", "place": "安提阿", "lat": 36.2, "lon": 36.15, "offices": ["執事", "主教"], "kin": [], "friends": ["Eunomius of Cyzicus"], "foes": ["Basil of Caesarea"], "bio": "敘利亞人，繼阿里烏之後倡言聖子與聖父不相似、乃由無中受造，從者號「埃提烏斯派」。阿里米努姆會議後以褻瀆上帝之罪遭流放，其說一度沉寂。弟子歐諾米烏斯後來重揚其說，世人遂多以歐諾米烏斯之名稱之。", "stats": [15, 12, 80, 35, 55], "lean": "無", "conf": "B", "src": "Sozomen 6.26"}
{"name_en": "Eleusius of Cyzicus", "zh": "厄琉西", "sei": "厄", "mei": "琉西", "zh_full": "西齊庫斯的厄琉西烏斯", "sex": "m", "years": [356, 381], "birth": null, "death": null, "death_violent": false, "polity": "馬其頓派", "role": "宗教", "place": "西齊庫斯", "lat": 40.38, "lon": 27.89, "offices": ["西齊庫斯主教"], "kin": [], "friends": ["Macedonius of Constantinople"], "foes": ["Eunomius of Cyzicus", "Eudoxius of Antioch"], "bio": "西齊庫斯主教，主聖子與聖父本質相似之說。後被逐，阿里烏派以歐諾米烏斯代領其教會；歐諾米烏斯在西齊庫斯公開宣講埃提烏斯之說，為其屬下教士所控。", "stats": [15, 12, 60, 50, 55], "lean": "無", "conf": "C", "src": "Sozomen 6.26"}
{"name_en": "Agelius", "zh": "阿格利", "sei": "阿", "mei": "格利", "zh_full": "阿格利烏斯", "sex": "m", "years": [345, 384], "birth": null, "death": 384, "death_violent": false, "polity": "諾瓦蒂安派", "role": "宗教", "place": "君士坦丁堡", "lat": 41.01, "lon": 28.98, "offices": ["君士坦丁堡諾瓦蒂安派主教"], "kin": [], "friends": [], "foes": [], "bio": "君士坦丁堡諾瓦蒂安派主教，為該派所尊奉的領袖之一。弗里吉亞諾瓦蒂安派主教聚會於帕祖科梅，議定依猶太曆守逾越節，阿格利烏斯與尼西亞、尼科米底亞、科蒂艾翁諸主教皆不與其會。", "stats": [12, 10, 55, 50, 62], "lean": "無", "conf": "C", "src": "Sozomen 6.24"}
{"name_en": "Vitalis of Antioch", "zh": "維塔利", "sei": "維", "mei": "塔利", "zh_full": "安提阿的維塔利斯", "sex": "m", "years": [360, 380], "birth": null, "death": null, "death_violent": false, "polity": "阿波利拿里派", "role": "宗教", "place": "安提阿", "lat": 36.2, "lon": 36.15, "offices": ["長老", "主教"], "kin": [], "friends": ["Apollinaris of Laodicea"], "foes": ["Flavian I of Antioch", "Meletius of Antioch"], "bio": "安提阿長老，梅勒提烏斯所授職，以生平操行著稱，為民眾所敬。據說因同僚弗拉維安阻其謁見主教，自覺受辱，遂脫離梅勒提烏斯，投阿波利拿里斯，在安提阿統領同道，其徒號「維塔利派」。", "stats": [12, 10, 60, 45, 68], "lean": "無", "conf": "B", "src": "Sozomen 6.25"}
{"name_en": "Magnus (comes sacrarum largitionum)", "zh": "馬格努", "sei": "馬", "mei": "格努", "zh_full": "馬格努斯", "sex": "m", "years": [362, 373], "birth": null, "death": null, "death_violent": false, "polity": "羅馬帝國", "role": "文臣", "place": "亞歷山大", "lat": 31.2, "lon": 29.9, "offices": ["聖庫伯爵"], "kin": [], "friends": ["Valens", "Euzoius of Antioch", "Lucius of Alexandria"], "foes": ["Pope Peter II of Alexandria"], "bio": "瓦倫斯的聖庫伯爵（掌國庫）。阿塔那修既卒，奉帝命與阿里烏派的歐佐伊烏斯同赴亞歷山大，拘禁阿塔那修所立的主教彼得，將教會交予盧基烏斯，城中正統派教士、修女自此橫遭迫害。", "stats": [35, 30, 50, 55, 30], "lean": "無", "conf": "B", "src": "Sozomen 6.19"}
{"name_en": "Heraclides (disciple of Antony)", "zh": "赫拉克利", "sei": "赫", "mei": "拉克利", "zh_full": "赫拉克利德斯", "sex": "m", "years": [350, 375], "birth": null, "death": null, "death_violent": false, "polity": "羅馬教會", "role": "宗教", "place": "埃及", "lat": 30.4, "lon": 30.3, "offices": ["修士"], "kin": [], "friends": ["Macarius of Egypt", "Pambo"], "foes": ["Lucius of Alexandria"], "bio": "安東尼的弟子，與兩位馬加略、潘博同為埃及苦修者之首領，堅拒阿里烏之說。盧基烏斯率軍強逼諸修士附從，眾人引頸待戮而不改其信。", "stats": [10, 10, 50, 30, 60], "lean": "無", "conf": "C", "src": "Sozomen 6.20"}
