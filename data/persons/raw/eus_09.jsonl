{"name_en": "Meletius of Pontus", "zh": "梅勒提", "sei": "梅勒", "mei": "提", "zh_full": "本都的梅勒提烏斯", "sex": "m", "years": [300, 310], "birth": null, "death": null, "death_violent": false, "polity": "羅馬教會", "role": "宗教", "place": "本都", "lat": 40.58, "lon": 36.95, "offices": ["主教"], "kin": [], "friends": [], "foes": [], "bio": "本都諸教會的主教，學者稱之為「阿提卡之蜜」。辯才天成，學識淵博，堪稱各門文學中最博學者，品行亦卓然。大迫害時在巴勒斯坦各地逃亡長達七年。", "stats": [12, 10, 80, 55, 76], "lean": "無", "conf": "B", "src": "Eusebius HE 7.32"}
{"name_en": "Dorotheus (cubicularius)", "zh": "多羅特烏", "sei": "多羅", "mei": "特烏", "zh_full": "尼科米底亞的多羅特烏斯", "sex": "m", "years": [298, 303], "birth": null, "death": 303, "death_violent": true, "polity": "羅馬帝國", "role": "宗教", "place": "尼科米底亞", "lat": 40.77, "lon": 29.92, "offices": ["宮廷侍從"], "kin": [], "friends": ["Gorgonius", "Peter (cubicularius)"], "foes": ["Diocletian"], "bio": "戴克里先宮中侍從，忠誠勤懇過於眾人，所受尊崇勝過總督。大迫害起，與戈爾戈紐斯等宮中僕役歷經各種酷刑，終被絞死；死後遺體入葬，又被主子掘出拋入海中。", "stats": [15, 20, 50, 55, 65], "lean": "無", "conf": "B", "src": "Eusebius HE 8.1; 8.6"}
{"name_en": "Peter (cubicularius)", "zh": "彼得", "sei": "彼", "mei": "得", "zh_full": "宮廷侍從彼得", "sex": "m", "years": [303, 303], "birth": null, "death": 303, "death_violent": true, "polity": "羅馬帝國", "role": "宗教", "place": "尼科米底亞", "lat": 40.77, "lon": 29.92, "offices": ["宮廷侍從"], "kin": [], "friends": ["Dorotheus (cubicularius)", "Gorgonius"], "foes": ["Diocletian"], "bio": "尼科米底亞宮中侍從。大迫害時被帶到眾前令獻祭，拒之；裸身吊起鞭打至見骨，再以醋鹽澆傷，又置於鐵架上以文火慢烤，始終不屈，在酷刑中氣絕，人稱名副其實的「磐石」。", "stats": [10, 30, 35, 30, 55], "lean": "無", "conf": "B", "src": "Eusebius HE 8.6"}
