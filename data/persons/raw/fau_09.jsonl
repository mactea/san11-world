{"name_en": "Shaghita", "zh": "沙吉塔", "sei": "沙", "mei": "吉塔", "zh_full": "聖沙吉塔", "sex": "m", "years": [350, 380], "birth": null, "death": null, "death_violent": false, "polity": "亞美尼亞教會", "role": "宗教", "place": "科爾杜克", "lat": 37.5, "lon": 43.0, "offices": ["隱修士"], "kin": [], "friends": ["Daniel I of Armenia", "Epiphanius (Armenian hermit)"], "bio": "敘利亞人，聖但以理門徒，自幼居獅山荒野以草為食。納爾謝斯死時，於山中望見其魂升天。後往科爾杜克州行神蹟，常有群獅相隨，曾為獅拔刺。年老時渡河沒入水中，眾人改道尋屍終不得。", "stats": [10, 15, 65, 30, 65], "lean": "無", "conf": "C", "src": "Faustus 5.26"}
{"name_en": "Epiphanius (Armenian hermit)", "zh": "伊皮法紐", "sei": "伊", "mei": "皮法紐", "zh_full": "聖伊皮法紐（亞美尼亞隱修士）", "sex": "m", "years": [350, 380], "birth": null, "death": null, "death_violent": false, "polity": "亞美尼亞教會", "role": "宗教", "place": "大措普", "lat": 38.7, "lon": 40.5, "offices": ["隱修士"], "kin": [], "friends": ["Daniel I of Armenia", "Shaghita"], "bio": "希臘裔隱修士，聖但以理門徒，居阿娜希特寶座山。納爾謝斯死後退居大措普曼布雷荒野，遍立修院，又於阿赫茲尼克建院，在提格雷諾塞塔奠立殉道者教堂。後率門徒五百人赴希臘之地，渡海居於一荒島而終。", "stats": [12, 12, 68, 50, 72], "lean": "無", "conf": "C", "src": "Faustus 5.27"}
{"name_en": "Bat Saharuni", "zh": "巴特", "sei": "巴", "mei": "特", "zh_full": "巴特·薩哈魯尼", "sex": "m", "years": [374, 378], "birth": null, "death": null, "death_violent": false, "polity": "亞美尼亞（阿沙克王朝）", "role": "谋士", "place": "亞美尼亞", "lat": 39.5, "lon": 43.0, "offices": ["薩哈魯尼家族首領", "王傅"], "kin": [], "friends": ["Varazdat"], "foes": ["Mushegh I Mamikonian"], "bio": "薩哈魯尼家族之長，瓦拉茲達特王的養父。覬覦大將之位，屢向瓦拉茲達特讒言，稱馬米科尼揚家世為阿沙克王室之敵，穆舍赫數縱沙普爾、送還其妃嬪，居心叵測，遂唆使年少的國王誅殺穆舍赫。", "stats": [40, 40, 58, 45, 40], "lean": "無", "conf": "B", "src": "Faustus 5.35"}
