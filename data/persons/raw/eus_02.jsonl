{"name_en": "Gaius of Eumeneia", "zh": "蓋烏斯", "sei": "蓋", "mei": "烏斯", "zh_full": "歐邁尼亞的蓋烏斯", "sex": "m", "years": [175, 190], "birth": null, "death": null, "death_violent": true, "polity": "羅馬教會", "role": "宗教", "place": "阿帕米亞", "lat": 38.07, "lon": 30.17, "offices": [], "kin": [], "friends": ["Alexander of Eumeneia"], "foes": [], "bio": "歐邁尼亞的基督徒，與亞歷山大在邁安德河畔的阿帕米亞殉道。臨刑時拒絕與同被處決的孟他努派「殉道者」相通，以示與異端劃清界限。", "stats": [10, 15, 40, 25, 50], "lean": "無", "conf": "C", "src": "Eusebius HE 5.16"}
{"name_en": "Alexander of Eumeneia", "zh": "亞歷山大", "sei": "亞歷", "mei": "山大", "zh_full": "歐邁尼亞的亞歷山大", "sex": "m", "years": [175, 190], "birth": null, "death": null, "death_violent": true, "polity": "羅馬教會", "role": "宗教", "place": "阿帕米亞", "lat": 38.07, "lon": 30.17, "offices": [], "kin": [], "friends": ["Gaius of Eumeneia"], "foes": [], "bio": "歐邁尼亞的基督徒，與蓋烏斯同在阿帕米亞殉道。至死不肯與孟他努派的殉道者交通，為反孟他努派作者所稱引。", "stats": [10, 15, 40, 25, 50], "lean": "無", "conf": "C", "src": "Eusebius HE 5.16"}
{"name_en": "Miltiades (apologist)", "zh": "米太亞德", "sei": "米太", "mei": "亞德", "zh_full": "護教者米太亞德", "sex": "m", "years": [170, 190], "birth": null, "death": null, "death_violent": false, "polity": "羅馬教會", "role": "学者", "place": "小亞細亞", "lat": 38.5, "lon": 28.5, "offices": [], "kin": [], "friends": [], "foes": ["Montanus"], "bio": "基督教作家，著書論先知不應在狂迷中說話，駁斥孟他努派，其書曾遭孟他努派攻擊。又分著《駁外邦人》、《駁猶太人》，並向世間統治者上護教書，為其所奉之哲學辯護。", "stats": [10, 10, 78, 45, 55], "lean": "無", "conf": "B", "src": "Eusebius HE 5.17; 5.28"}
{"name_en": "Alexander the Montanist", "zh": "亞歷山大", "sei": "亞歷", "mei": "山大", "zh_full": "孟他努派的亞歷山大", "sex": "m", "years": [180, 195], "birth": null, "death": null, "death_violent": false, "polity": "孟他努派", "role": "其他", "place": "以弗所", "lat": 37.94, "lon": 27.34, "offices": [], "kin": [], "friends": ["Maximilla"], "foes": ["Aemilius Frontinus", "Apollonius of Ephesus"], "bio": "孟他努派奉為殉道者之人，與女先知同宴樂，受眾人敬拜。實為慣犯，曾因搶劫被亞細亞總督弗朗提努斯判罪，冒稱信主得釋，其本教區因其為盜不肯接納，亞細亞公檔俱載其事。", "stats": [25, 45, 40, 20, 45], "lean": "無", "conf": "B", "src": "Eusebius HE 5.18"}
{"name_en": "Aemilius Frontinus", "zh": "弗朗提努", "sei": "弗朗", "mei": "提努", "zh_full": "埃米利烏斯·弗朗提努斯", "sex": "m", "years": [180, 190], "birth": null, "death": null, "death_violent": false, "polity": "羅馬帝國", "role": "文臣", "place": "以弗所", "lat": 37.94, "lon": 27.34, "offices": ["亞細亞總督"], "kin": [], "friends": [], "foes": ["Alexander the Montanist"], "bio": "羅馬亞細亞總督，駐以弗所。孟他努派所謂殉道者亞歷山大，實因搶劫被其判罪，非因信仰。", "stats": [45, 35, 50, 55, 40], "lean": "無", "conf": "C", "src": "Eusebius HE 5.18"}
{"name_en": "Maximinus of Antioch", "zh": "馬克西明", "sei": "馬克", "mei": "西明", "zh_full": "安條克的馬克西米努斯", "sex": "m", "years": [170, 190], "birth": null, "death": null, "death_violent": false, "polity": "羅馬教會", "role": "宗教", "place": "安條克", "lat": 36.2, "lon": 36.16, "offices": ["安條克主教"], "kin": [], "friends": [], "foes": [], "bio": "安條克主教，康茂德在位時主持教會。去世後由塞拉皮翁繼任，塞拉皮翁為使徒以後安條克第八任主教。", "stats": [15, 10, 50, 50, 45], "lean": "無", "conf": "C", "src": "Eusebius HE 5.19"}
{"name_en": "Aurelius Cyrenaeus", "zh": "昔蘭尼", "sei": "昔", "mei": "蘭尼", "zh_full": "奧勒留·昔蘭尼烏斯", "sex": "m", "years": [190, 200], "birth": null, "death": null, "death_violent": false, "polity": "羅馬教會", "role": "宗教", "place": "安條克", "lat": 36.2, "lon": 36.16, "offices": [], "kin": [], "friends": ["Serapion of Antioch"], "foes": ["Montanus"], "bio": "曾為信仰受苦的認信者，在塞拉皮翁駁孟他努派的書信上簽名，自署「殉道者」，願收信人安好。", "stats": [10, 15, 40, 30, 45], "lean": "無", "conf": "C", "src": "Eusebius HE 5.19"}
{"name_en": "Aelius Publius Julius", "zh": "尤利烏斯", "sei": "尤利", "mei": "烏斯", "zh_full": "埃利烏斯·普布利烏斯·尤利烏斯", "sex": "m", "years": [190, 200], "birth": null, "death": null, "death_violent": false, "polity": "羅馬教會", "role": "宗教", "place": "德貝爾圖姆", "lat": 42.39, "lon": 27.35, "offices": ["德貝爾圖姆主教"], "kin": [], "friends": ["Sotas of Anchialus", "Serapion of Antioch"], "foes": [], "bio": "色雷斯殖民地德貝爾圖姆主教，在塞拉皮翁的書信上簽名作證：安基阿盧斯的索塔斯曾欲為普里斯卡驅魔，而偽善者不容。", "stats": [15, 10, 50, 50, 45], "lean": "無", "conf": "C", "src": "Eusebius HE 5.19"}
{"name_en": "Sotas of Anchialus", "zh": "索塔斯", "sei": "索", "mei": "塔斯", "zh_full": "安基阿盧斯的索塔斯", "sex": "m", "years": [170, 190], "birth": null, "death": null, "death_violent": false, "polity": "羅馬教會", "role": "宗教", "place": "安基阿盧斯", "lat": 42.7, "lon": 27.65, "offices": ["安基阿盧斯主教"], "kin": [], "friends": [], "foes": ["Prisca (Prophet)"], "bio": "色雷斯安基阿盧斯主教，有福之人。曾欲為孟他努派女先知普里斯卡驅魔，為其黨中偽善者所阻，未能成事。", "stats": [15, 10, 50, 45, 50], "lean": "無", "conf": "C", "src": "Eusebius HE 5.19"}
{"name_en": "Bacchyllus of Corinth", "zh": "巴庫洛", "sei": "巴", "mei": "庫洛", "zh_full": "哥林多的巴庫洛斯", "sex": "m", "years": [189, 195], "birth": null, "death": null, "death_violent": false, "polity": "羅馬教會", "role": "宗教", "place": "哥林多", "lat": 37.9, "lon": 22.9, "offices": ["哥林多主教"], "kin": [], "friends": ["Pope Victor I"], "foes": [], "bio": "希臘哥林多主教。復活節之爭中，以個人名義致書，主張只能在主日結束逾越節禁食，與各地主教意見一致。", "stats": [15, 10, 60, 55, 50], "lean": "無", "conf": "B", "src": "Eusebius HE 5.22; 5.23"}
{"name_en": "Palmas of Amastris", "zh": "帕爾馬", "sei": "帕", "mei": "爾馬", "zh_full": "阿馬斯特里斯的帕爾馬斯", "sex": "m", "years": [170, 195], "birth": null, "death": null, "death_violent": false, "polity": "羅馬教會", "role": "宗教", "place": "阿馬斯特里斯", "lat": 41.75, "lon": 32.38, "offices": ["本都主教"], "kin": [], "friends": [], "foes": [], "bio": "本都諸主教中最年長者。復活節之爭時主持本都主教會議，聯名致書，主張只能在主日慶祝主復活、結束逾越節禁食。", "stats": [15, 10, 55, 55, 55], "lean": "無", "conf": "C", "src": "Eusebius HE 5.23"}
{"name_en": "Melito of Sardis", "zh": "墨利托", "sei": "墨", "mei": "利托", "zh_full": "撒狄的墨利托", "sex": "m", "years": [170, 180], "birth": null, "death": 180, "death_violent": false, "polity": "羅馬教會", "role": "学者", "place": "撒狄", "lat": 38.49, "lon": 28.04, "offices": ["撒狄主教"], "kin": [], "friends": [], "foes": [], "bio": "撒狄主教，宦官，一生全然活在聖靈中，葬於撒狄待主降臨。守尼散月十四日為逾越節，為波利克拉底所稱引的亞細亞「大光」之一，其著作宣揚基督為神為人。", "stats": [10, 10, 82, 55, 70], "lean": "無", "conf": "C", "src": "Eusebius HE 5.24; 5.28; 6.13"}
{"name_en": "Cassius of Tyre", "zh": "卡西烏斯", "sei": "卡西", "mei": "烏斯", "zh_full": "推羅的卡西烏斯", "sex": "m", "years": [189, 195], "birth": null, "death": null, "death_violent": false, "polity": "羅馬教會", "role": "宗教", "place": "推羅", "lat": 33.27, "lon": 35.2, "offices": ["推羅主教"], "kin": [], "friends": ["Narcissus of Jerusalem", "Theophilus, bishop of Caesarea", "Clarus of Ptolemais"], "foes": [], "bio": "推羅主教，與納西瑟斯、狄奧菲盧斯等巴勒斯坦主教集會論逾越節，聯名致書，請各教區傳抄，並言亞歷山大里亞與其同日守節。", "stats": [15, 10, 55, 55, 50], "lean": "無", "conf": "C", "src": "Eusebius HE 5.25"}
{"name_en": "Clarus of Ptolemais", "zh": "克拉魯", "sei": "克", "mei": "拉魯", "zh_full": "多利買的克拉魯斯", "sex": "m", "years": [189, 195], "birth": null, "death": null, "death_violent": false, "polity": "羅馬教會", "role": "宗教", "place": "多利買", "lat": 32.92, "lon": 35.08, "offices": ["多利買主教"], "kin": [], "friends": ["Narcissus of Jerusalem", "Theophilus, bishop of Caesarea", "Cassius of Tyre"], "foes": [], "bio": "多利買主教。參與納西瑟斯、狄奧菲盧斯召集的巴勒斯坦主教會議，詳論使徒傳下的逾越節傳統，聯名致書各教區。", "stats": [15, 10, 55, 55, 50], "lean": "無", "conf": "C", "src": "Eusebius HE 5.25"}
{"name_en": "Theodotus the Banker", "zh": "狄奧多", "sei": "狄", "mei": "奧多", "zh_full": "銀錢商狄奧多圖斯", "sex": "m", "years": [195, 215], "birth": null, "death": null, "death_violent": false, "polity": "狄奧多都派", "role": "宗教", "place": "羅馬", "lat": 41.9, "lon": 12.5, "offices": [], "kin": [], "friends": ["Asclepiodotus (Theodotian)", "Theodotus of Byzantium"], "foes": ["Pope Zephyrinus"], "bio": "羅馬銀錢商，皮匠狄奧多都的門徒，主張基督只是凡人。與阿斯克勒庇奧多圖斯誘使認信者納塔利烏斯受其黨主教之名，月俸一百五十第納里。其黨好以三段論解經，崇尚歐幾里得、亞里斯多德，並擅改聖經抄本。", "stats": [15, 10, 70, 60, 45], "lean": "無", "conf": "B", "src": "Eusebius HE 5.28"}
{"name_en": "Asclepiodotus (Theodotian)", "zh": "阿斯克勒", "sei": "阿斯", "mei": "克勒", "zh_full": "阿斯克勒庇奧多圖斯", "sex": "m", "years": [195, 215], "birth": null, "death": null, "death_violent": false, "polity": "狄奧多都派", "role": "宗教", "place": "羅馬", "lat": 41.9, "lon": 12.5, "offices": [], "kin": [], "friends": ["Theodotus the Banker", "Theodotus of Byzantium"], "foes": ["Pope Zephyrinus"], "bio": "皮匠狄奧多都的門徒，與銀錢商狄奧多圖斯同在羅馬傳嗣子說，誘認信者納塔利烏斯為其黨主教。又自行校改聖經，其抄本與狄奧多圖斯所傳彼此不合。", "stats": [15, 10, 65, 45, 40], "lean": "無", "conf": "B", "src": "Eusebius HE 5.28"}
