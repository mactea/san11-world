{"name_en": "Ishwarsena", "zh": "伊濕犀那", "sei": "伊濕", "mei": "犀那", "zh_full": "阿毗羅·伊濕伐羅犀那", "sex": "m", "years": [188, 249], "birth": null, "death": null, "death_violent": false, "polity": "阿毗羅王朝", "role": "君主", "place": "納西克", "lat": 20.0, "lon": 73.79, "offices": ["王"], "kin": [{"rel": "父", "name": "Sivadatta"}, {"rel": "母", "name": "Mathari"}, {"rel": "兄", "name": "Sakasena"}], "friends": [], "foes": ["Rudrasimha I"], "bio": "阿毗羅王朝首位自主之君，濕婆達多與摩陀利之子。或謂本為魯陀羅辛哈一世之將，188年廢主自立，190年復為所逐。開創後稱迦拉丘里—車底紀元之年號，子孫傳九世。納西克石窟存其梵文銘文。", "stats": [68, 60, 60, 65, 65], "lean": "無", "conf": "B", "src": "Wikipedia: Abhira dynasty"}
{"name_en": "Sakasena", "zh": "沙迦犀那", "sei": "沙迦", "mei": "犀那", "zh_full": "沙迦犀那（沙迦·薩塔卡尼）", "sex": "m", "years": [200, 230], "birth": null, "death": null, "death_violent": false, "polity": "阿毗羅王朝", "role": "君主", "place": "孔坎", "lat": 17.5, "lon": 73.3, "offices": ["王"], "kin": [{"rel": "母", "name": "Mathari"}, {"rel": "弟", "name": "Ishwarsena"}], "friends": [], "foes": [], "bio": "號摩陀利子，或即錢幣上之沙迦·薩塔卡尼，向被視為百乘王朝雅吉納·室利·薩塔卡尼之後繼者。學者戈帕拉查里以為其實為阿毗羅王，伊濕伐羅犀那之兄。其銘文見於孔坎，錢幣出於安得拉，所轄或包有百乘故地之大半。", "stats": [62, 55, 55, 60, 60], "lean": "無", "conf": "C", "src": "Wikipedia: Abhira dynasty"}
{"name_en": "Isvaradatta", "zh": "伊濕達多", "sei": "伊濕", "mei": "達多", "zh_full": "伊濕伐羅達多", "sex": "m", "years": [180, 200], "birth": null, "death": null, "death_violent": false, "polity": "阿毗羅王朝", "role": "君主", "place": "古吉拉特", "lat": 22.3, "lon": 70.5, "offices": ["大總督"], "kin": [], "friends": [], "foes": [], "bio": "阿毗羅族首領，二世紀時自稱大總督。或謂其攻西方總督而勝之，創特賴庫塔王朝，以特賴庫塔為都。", "stats": [62, 58, 50, 55, 58], "lean": "無", "conf": "C", "src": "Wikipedia: Abhira dynasty"}
{"name_en": "Vasusena", "zh": "婆藪犀那", "sei": "婆藪", "mei": "犀那", "zh_full": "婆私吒子·婆藪犀那", "sex": "m", "years": [250, 290], "birth": null, "death": null, "death_violent": false, "polity": "阿毗羅王朝", "role": "君主", "place": "納西克", "lat": 20.0, "lon": 73.79, "offices": ["王"], "kin": [], "friends": [], "foes": [], "bio": "阿毗羅王，號婆私吒子。其歿後，阿毗羅失其宗主之位，北為伐迦陀迦、西南為卡丹巴所侵，終為其藩屬特賴庫塔所代。", "stats": [50, 45, 45, 50, 50], "lean": "無", "conf": "C", "src": "Wikipedia: Abhira dynasty"}
