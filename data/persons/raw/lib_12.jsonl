{"name_en": "Letoius", "zh": "萊托", "sei": "萊", "mei": "托", "zh_full": "萊托伊烏斯", "sex": "m", "years": [357, 357], "birth": null, "death": null, "death_violent": false, "polity": "羅馬帝國", "role": "文臣", "place": "安條克", "lat": 36.2, "lon": 36.16, "offices": ["安條克元老", "使節"], "kin": [], "friends": ["Libanius", "Barbatio", "Mygdonius", "Eugnomonius"], "foes": [], "bio": "安條克元老之首，出身名門，善辭令，屢以家財承擔公共捐輸。三五七年奉城邦之命出使宮廷，利巴尼烏斯為之遍致書信於巴巴提奧、穆索尼亞努斯等顯貴，請予照拂。", "stats": [25, 20, 58, 62, 66], "lean": "無", "conf": "B", "src": "Libanius Ep. 555-559"}
