{"name_en": "Racius Constans", "zh": "康斯坦", "sei": "康", "mei": "斯坦", "zh_full": "拉基烏斯·康斯坦斯", "sex": "m", "years": [204, 204], "birth": null, "death": null, "death_violent": false, "polity": "羅馬帝國", "role": "文臣", "place": "撒丁尼亞", "lat": 40.0, "lon": 9.0, "offices": ["撒丁尼亞總督"], "kin": [], "friends": [], "foes": ["Gaius Fulvius Plautianus"], "bio": "撒丁尼亞總督，名重一時。塞維魯嫌普勞蒂安像太多，熔毀數尊，諸城訛傳普勞蒂安已倒，康斯坦斯遂毀其像，因而被控，雖塞維魯言普勞蒂安必不受害，後仍以此獲罪。", "stats": [40, 35, 50, 52, 52], "lean": "無", "conf": "C", "src": "Dio 75.16"}
{"name_en": "Coeranus", "zh": "科拉努", "sei": "科", "mei": "拉努", "zh_full": "科埃拉努斯", "sex": "m", "years": [205, 212], "birth": null, "death": null, "death_violent": false, "polity": "羅馬帝國", "role": "文臣", "place": "羅馬", "lat": 41.9, "lon": 12.5, "offices": ["元老", "執政官"], "kin": [], "friends": ["Gaius Fulvius Plautianus"], "foes": [], "bio": "埃及人，普勞蒂安親信。嘗為普勞蒂安解夢，謂其當主宰陸海。普勞蒂安敗，自稱不預其密，反益見疑，流放海島七年。後獲召還，為首位列名元老院之埃及人，未歷他職而徑登執政官。", "stats": [30, 25, 62, 58, 55], "lean": "無", "conf": "B", "src": "Dio 76.5"}
{"name_en": "Caecilius Agricola", "zh": "阿格里", "sei": "阿", "mei": "格里", "zh_full": "凱基利烏斯·阿格里科拉", "sex": "m", "years": [205, 205], "birth": null, "death": 205, "death_violent": true, "polity": "羅馬帝國", "role": "文臣", "place": "羅馬", "lat": 41.9, "lon": 12.5, "offices": ["元老"], "kin": [], "friends": ["Gaius Fulvius Plautianus"], "foes": [], "bio": "普勞蒂安之首要諂媚者，奸詐淫逸無人能及。普勞蒂安被殺後被判死刑，歸家痛飲冰酒，擊碎值二十萬塞斯特斯之酒杯，割脈倒斃於碎片之上。", "stats": [30, 30, 45, 35, 30], "lean": "無", "conf": "B", "src": "Dio 76.5"}
{"name_en": "Gaius Fulvius Plautius Hortensianus", "zh": "普勞提", "sei": "普", "mei": "勞提", "zh_full": "蓋烏斯·富爾維烏斯·普勞提烏斯·霍騰西亞努斯", "sex": "m", "years": [205, 212], "birth": null, "death": 212, "death_violent": true, "polity": "羅馬帝國", "role": "其他", "place": "利帕里島", "lat": 38.47, "lon": 14.95, "offices": [], "kin": [{"rel": "父", "name": "Gaius Fulvius Plautianus"}, {"rel": "姊", "name": "Fulvia Plautilla"}], "friends": [], "foes": ["Caracalla"], "bio": "普勞蒂安之子。父被誅後，與姊普勞蒂拉暫得免死，流放利帕里島，生活困頓，終日憂懼。卡拉卡拉即位後，與普勞蒂拉同被殺。", "stats": [25, 30, 30, 25, 30], "lean": "無", "conf": "B", "src": "Dio 76.6"}
{"name_en": "Baebius Marcellinus", "zh": "馬塞利", "sei": "馬", "mei": "塞利", "zh_full": "貝比烏斯·馬塞利努斯", "sex": "m", "years": [205, 205], "birth": null, "death": 205, "death_violent": true, "polity": "羅馬帝國", "role": "文臣", "place": "羅馬", "lat": 41.9, "lon": 12.5, "offices": ["市政官", "元老"], "kin": [], "friends": [], "foes": ["Pollienus Sebennus"], "bio": "元老，曾任市政官，頭頂甚禿。阿普羅尼亞努斯謀逆案中，供詞稱有禿頭著紫邊袍之元老窺探，眾目皆注之，遂自出請對質，告密者依人暗示指認之。出元老院至廣場，訣別四子而被斬，塞維魯猶未知其定罪。", "stats": [30, 30, 50, 45, 55], "lean": "無", "conf": "B", "src": "Dio 76.8"}
{"name_en": "Pollienus Sebennus", "zh": "塞本努", "sei": "塞", "mei": "本努", "zh_full": "波利埃努斯·塞本努斯", "sex": "m", "years": [205, 206], "birth": null, "death": null, "death_violent": false, "polity": "羅馬帝國", "role": "文臣", "place": "羅馬", "lat": 41.9, "lon": 12.5, "offices": ["諾里庫姆總督"], "kin": [{"rel": "叔父", "name": "Pollienus Auspex (consul under Commodus)"}], "friends": [], "foes": ["Baebius Marcellinus", "Sabinus (enemy of Sebennus)"], "bio": "元老，曾任諾里庫姆總督，待當地人刻薄。控告馬塞利努斯致其被斬。後被薩比努斯交與諾里庫姆人處置，伏地哀告，受盡羞辱，賴叔父奧斯佩克斯之故方得免死。", "stats": [35, 30, 45, 35, 25], "lean": "無", "conf": "B", "src": "Dio 76.9"}
{"name_en": "Sabinus (enemy of Sebennus)", "zh": "薩比努", "sei": "薩", "mei": "比努", "zh_full": "薩比努斯", "sex": "m", "years": [206, 206], "birth": null, "death": null, "death_violent": false, "polity": "羅馬帝國", "role": "文臣", "place": "諾里庫姆", "lat": 47.5, "lon": 14.0, "offices": [], "kin": [], "friends": [], "foes": ["Pollienus Sebennus"], "bio": "塞維魯時人。告密者塞本努斯構陷馬塞利努斯致死，薩比努斯將其交與曾受其虐待之諾里庫姆人，使之備受羞辱，時人以為報應。", "stats": [40, 40, 45, 45, 40], "lean": "無", "conf": "C", "src": "Dio 76.9"}
{"name_en": "Castor (freedman of Severus)", "zh": "卡斯托", "sei": "卡", "mei": "斯托", "zh_full": "卡斯托爾", "sex": "m", "years": [209, 211], "birth": null, "death": 211, "death_violent": true, "polity": "羅馬帝國", "role": "文臣", "place": "艾布拉肯", "lat": 53.96, "lon": -1.08, "offices": ["秘書", "侍從長"], "kin": [], "friends": ["Septimius Severus", "Aemilius Papinianus"], "foes": ["Caracalla"], "bio": "塞維魯身邊最賢之釋奴，兼掌文書與內寢。卡拉卡拉嘗誣稱受其欺凌，煽動士兵鼓噪。卡拉卡拉欲弒父，塞維魯召其與帕比尼安同至，當面責子。塞維魯死後，被卡拉卡拉所殺。", "stats": [25, 25, 60, 62, 50], "lean": "無", "conf": "B", "src": "Dio 76.14"}
