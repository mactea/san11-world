{"name_en": "Priscianus (rhetor of Antioch)", "zh": "普里西安", "sei": "普里", "mei": "西安", "zh_full": "普里西安努斯", "sex": "m", "years": [358, 360], "birth": null, "death": null, "death_violent": false, "polity": "羅馬帝國", "role": "名士", "place": "安條克", "lat": 36.2, "lon": 36.16, "offices": ["修辭家"], "kin": [], "friends": ["Libanius", "Florentius (magister officiorum)", "Themistius", "Albanius"], "foes": [], "bio": "安條克修辭家，利巴尼烏斯視為至親摯友，在城中以辯才與訟事見稱，法官每以其意為斷。359年宮廷總管弗洛倫提烏斯薦之於君士坦提烏斯二世，召赴宮廷；後隨駕至多瑙河前線，返君士坦丁堡授以要職，舉屬吏入幕。", "stats": [30, 20, 72, 66, 68], "lean": "無", "conf": "B", "src": "Libanius Ep. 61"}
{"name_en": "Ianuarius (official at Antioch)", "zh": "雅努阿里", "sei": "雅努", "mei": "阿里", "zh_full": "雅努阿里烏斯", "sex": "m", "years": [357, 358], "birth": null, "death": null, "death_violent": false, "polity": "羅馬帝國", "role": "文臣", "place": "安條克", "lat": 36.2, "lon": 36.16, "offices": [], "kin": [], "friends": ["Libanius", "Aristaenetus"], "foes": [], "bio": "安條克官員，為城人所敬。在任守職謹嚴，言少而能斷，不擾無辜，施恩合於公道。利巴尼烏斯原欲緘口，為其所催而致書阿納托利烏斯；又往見阿里斯泰內圖斯，報利巴尼烏斯病況。", "stats": [40, 35, 55, 60, 55], "lean": "無", "conf": "C", "src": "Libanius Ep. 19"}
{"name_en": "Domnus (of Tarsus)", "zh": "多姆努", "sei": "多姆", "mei": "努", "zh_full": "多姆努斯", "sex": "m", "years": [358, 359], "birth": null, "death": null, "death_violent": false, "polity": "羅馬帝國", "role": "其他", "place": "塔爾蘇斯", "lat": 36.92, "lon": 34.89, "offices": [], "kin": [], "friends": ["Demetrius of Tarsus", "Libanius", "Domitius Modestus"], "foes": [], "bio": "塔爾蘇斯人，德米特里烏斯之族人。因將聯姻遭人刁難，利巴尼烏斯為之解圍。東方伯莫德斯圖斯延緩其罰，令其求皇帝寬恕；得赦後，利巴尼烏斯又請莫德斯圖斯保全其田產。", "stats": [25, 25, 40, 40, 40], "lean": "無", "conf": "C", "src": "Libanius Ep. 53"}
{"name_en": "Hierocles (died 358)", "zh": "希羅克勒", "sei": "希羅", "mei": "克勒", "zh_full": "希羅克勒斯", "sex": "m", "years": [358, 358], "birth": null, "death": 358, "death_violent": false, "polity": "羅馬帝國", "role": "名士", "place": "尼科米底亞", "lat": 40.77, "lon": 29.92, "offices": [], "kin": [{"rel": "弟", "name": "Julianus (brother of Hierocles)"}], "friends": ["Libanius", "Aristaenetus"], "foes": [], "bio": "利巴尼烏斯之友，358年尼科米底亞大地震中與阿里斯泰內圖斯同時罹難，利巴尼烏斯為之哀痛，久不登壇講演。其弟尤利安努斯品行與之相類。", "stats": [20, 20, 45, 45, 50], "lean": "無", "conf": "C", "src": "Libanius Ep. 26"}
{"name_en": "Julianus (brother of Hierocles)", "zh": "尤利安", "sei": "尤利", "mei": "安", "zh_full": "尤利安努斯", "sex": "m", "years": [358, 359], "birth": null, "death": null, "death_violent": false, "polity": "羅馬帝國", "role": "其他", "place": "君士坦丁堡", "lat": 41.01, "lon": 28.98, "offices": [], "kin": [{"rel": "兄", "name": "Hierocles (died 358)"}], "friends": ["Libanius", "Themistius"], "foes": [], "bio": "希羅克勒斯之弟，性行如其兄，可致富而不為。被錄入君士坦丁堡元老院，貧不能納金，赫莫傑尼斯察實而免之；利巴尼烏斯又請忒彌修斯解其餘累。", "stats": [20, 20, 40, 45, 45], "lean": "無", "conf": "C", "src": "Libanius Ep. 40"}
{"name_en": "Titianus (son of Acacius)", "zh": "提提安", "sei": "提提", "mei": "安", "zh_full": "提提安努斯", "sex": "m", "years": [358, 360], "birth": null, "death": null, "death_violent": false, "polity": "羅馬帝國", "role": "學者", "place": "凱撒利亞", "lat": 32.5, "lon": 34.9, "offices": [], "kin": [{"rel": "父", "name": "Acacius (sophist)"}], "friends": ["Libanius"], "foes": [], "bio": "凱撒利亞修辭家阿卡修斯之子，就學於利巴尼烏斯，勤於習文，由教僕馬塞盧斯督課。359年其父召之歸鄉，利巴尼烏斯不捨而遣之。所作演說辭章，利巴尼烏斯讀而稱美。", "stats": [15, 10, 62, 40, 50], "lean": "無", "conf": "B", "src": "Libanius Ep. 121"}
{"name_en": "Philoxenus (student of Libanius)", "zh": "菲洛克塞", "sei": "菲洛", "mei": "克塞", "zh_full": "菲洛克塞努斯", "sex": "m", "years": [358, 360], "birth": null, "death": null, "death_violent": false, "polity": "羅馬帝國", "role": "學者", "place": "凱撒利亞", "lat": 32.5, "lon": 34.9, "offices": [], "kin": [], "friends": ["Libanius", "Acacius (sophist)"], "foes": [], "bio": "阿卡修斯之親屬，埃克迪基烏斯之甥。其母託舅父請利巴尼烏斯收教，利巴尼烏斯許其可成辯士。後歸阿卡修斯處，以品行見稱。", "stats": [20, 15, 50, 40, 45], "lean": "無", "conf": "C", "src": "Libanius Ep. 45"}
{"name_en": "Macedonius (friend of Libanius)", "zh": "馬其頓尼", "sei": "馬其", "mei": "頓尼", "zh_full": "馬其頓尼烏斯", "sex": "m", "years": [358, 360], "birth": null, "death": null, "death_violent": false, "polity": "羅馬帝國", "role": "文臣", "place": "安條克", "lat": 36.2, "lon": 36.16, "offices": [], "kin": [], "friends": ["Libanius", "Florentius (magister officiorum)"], "foes": [], "bio": "利巴尼烏斯舊友，相處甚久，性溫和節制，善結交。棄修辭而入仕，有望致富而未得；359年利巴尼烏斯致書馬格努斯與宮廷總管弗洛倫提烏斯薦之。後嫁其姪女於友人。", "stats": [25, 20, 50, 50, 60], "lean": "無", "conf": "C", "src": "Libanius Ep. 85"}
{"name_en": "Polychronius", "zh": "波利克羅", "sei": "波利", "mei": "克羅", "zh_full": "波利克羅尼烏斯", "sex": "m", "years": [359, 360], "birth": null, "death": null, "death_violent": false, "polity": "羅馬帝國", "role": "文臣", "place": "安條克", "lat": 36.2, "lon": 36.16, "offices": [], "kin": [], "friends": ["Libanius"], "foes": [], "bio": "掌供給之官，奉上命削減利巴尼烏斯所得之糧，分小麥大麥而薄給馬料，愧不敢復書。利巴尼烏斯引阿基里斯之語，謂其過在上官，勸其安心通書。", "stats": [30, 25, 45, 50, 40], "lean": "無", "conf": "C", "src": "Libanius Ep. 28"}
{"name_en": "Adamantius (father of Anatolius)", "zh": "阿達曼", "sei": "阿達", "mei": "曼", "zh_full": "阿達曼提烏斯", "sex": "m", "years": [358, 360], "birth": null, "death": null, "death_violent": false, "polity": "羅馬帝國", "role": "其他", "place": "亞美尼亞", "lat": 40.0, "lon": 39.6, "offices": [], "kin": [], "friends": ["Libanius"], "foes": [], "bio": "亞美尼亞人，遣子阿納托利烏斯就學於利巴尼烏斯。聽信讒書而怒其子，後釋之；利巴尼烏斯遣歐馬提烏斯往為之辨誣，屢書勸其勿信讒言。", "stats": [25, 25, 40, 45, 40], "lean": "無", "conf": "C", "src": "Libanius Ep. 32"}
{"name_en": "Olympius (consularis Macedoniae)", "zh": "奧林皮", "sei": "奧林", "mei": "皮", "zh_full": "奧林皮烏斯", "sex": "m", "years": [358, 360], "birth": null, "death": null, "death_violent": false, "polity": "羅馬帝國", "role": "文臣", "place": "安條克", "lat": 36.2, "lon": 36.16, "offices": ["馬其頓總督", "君士坦丁堡元老"], "kin": [{"rel": "弟", "name": "Miccalus"}], "friends": ["Libanius", "Themistius", "Domitius Modestus"], "foes": [], "bio": "安條克名門。少年即治馬其頓，民受其惠，其後辭官不仕。為人公正，受屈者皆往投之，地方官每求其裁斷。被轉入君士坦丁堡元老院，利巴尼烏斯請忒彌修斯免其遠徙重捐；愛弟米卡盧斯如子，為之謀於宮廷。", "stats": [45, 30, 65, 72, 70], "lean": "無", "conf": "B", "src": "Libanius Ep. 70"}
