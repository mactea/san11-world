{"name_en": "Karen (Persian general)", "zh": "卡倫", "sei": "卡", "mei": "倫", "zh_full": "卡倫", "sex": "m", "years": [370, 370], "birth": null, "death": 370, "death_violent": true, "polity": "薩珊波斯", "role": "武将", "place": "亞美尼亞", "lat": 39.0, "lon": 42.0, "offices": ["將軍"], "kin": [], "friends": ["Shapur II", "Zik (general)"], "foes": ["Mushegh I Mamikonian", "Pap of Armenia"], "bio": "波斯將領，與齊克同駐亞美尼亞腹地。帕普在羅馬軍護送下歸國時，亞美尼亞大將穆舍赫率前鋒突入，卡倫與齊克皆被斬，所部盡沒。", "stats": [55, 58, 40, 35, 40], "lean": "騎", "conf": "C", "src": "Faustus 5.1"}
{"name_en": "Hayr (mardpet)", "zh": "海爾", "sei": "海", "mei": "爾", "zh_full": "海爾（馬爾德佩特）", "sex": "m", "years": [368, 370], "birth": null, "death": 370, "death_violent": true, "polity": "亞美尼亞（阿沙克王朝）", "role": "文臣", "place": "塔隆", "lat": 39.0, "lon": 41.5, "offices": ["馬爾德佩特（宮廷總管）"], "kin": [], "friends": [], "foes": ["Pharantzem", "Pap of Armenia", "Mushegh I Mamikonian"], "bio": "亞美尼亞宮廷宦官總管。王后帕蘭澤姆困守城堡時，潛入堡中辱罵王后如娼婦。帕普即位後密令穆舍赫處置，穆舍赫設宴誘至奧哈坎堡，剝衣縛手置於冰封的幼發拉底河上，凍斃而死。", "stats": [25, 30, 45, 50, 25], "lean": "無", "conf": "B", "src": "Faustus 5.3"}
{"name_en": "Dghak (mardpet)", "zh": "德哈克", "sei": "德", "mei": "哈克", "zh_full": "德哈克（馬爾德佩特）", "sex": "m", "years": [345, 371], "birth": null, "death": 371, "death_violent": true, "polity": "亞美尼亞（阿沙克王朝）", "role": "武将", "place": "甘札克", "lat": 36.6, "lon": 47.2, "offices": ["馬爾德佩特（宮廷總管）", "邊境守將"], "kin": [], "friends": ["Shapur II"], "foes": ["Pap of Armenia", "Mushegh I Mamikonian", "Terentius dux"], "bio": "曾於提蘭、阿爾沙克二世時任馬爾德佩特，海爾死後復任。特倫提烏斯與穆舍赫留其率三萬精兵守甘札克邊境，竟暗通沙普爾，許獻帕普及二將，受重金。格內爾等密告，帕普詐召之入宮，以寬衣縛其佩劍，於藏冠之室斬首，懸首營中。", "stats": [60, 62, 45, 40, 35], "lean": "槍", "conf": "B", "src": "Faustus 5.3"}
