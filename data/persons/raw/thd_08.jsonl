{"name_en": "Demosthenes (chef of Valens)", "zh": "狄摩西", "sei": "狄", "mei": "摩西", "zh_full": "狄摩西尼（御膳官）", "sex": "m", "years": [370, 372], "birth": null, "death": null, "death_violent": false, "polity": "羅馬帝國", "role": "文臣", "place": "凱撒利亞（卡帕多細亞）", "lat": 38.72, "lon": 35.49, "offices": ["御膳總管"], "kin": [], "friends": ["Valens"], "foes": ["Basil of Caesarea"], "bio": "瓦倫斯掌御膳之官。帝入凱撒利亞教堂聽巴西略講道，狄摩西尼從旁斥責，言語鄙俗不通。巴西略笑曰「今日得見不識字之狄摩西尼」，又謂其但宜調羹，不能聞神道。", "stats": [15, 25, 20, 30, 15], "lean": "無", "conf": "C", "src": "Theodoret 4.16"}
{"name_en": "Magnus (comes sacrarum largitionum)", "zh": "馬格努", "sei": "馬", "mei": "格努", "zh_full": "馬格努斯（聖庫伯）", "sex": "m", "years": [362, 374], "birth": null, "death": null, "death_violent": false, "polity": "羅馬帝國", "role": "文臣", "place": "亞歷山大", "lat": 31.2, "lon": 29.92, "offices": ["聖庫伯"], "kin": [], "friends": ["Lucius of Alexandria", "Euzoius of Antioch", "Valens"], "foes": ["Pope Peter II of Alexandria"], "bio": "尤利安時焚毀貝里圖斯教堂，約維安朝被迫自費重建，幾遭斬首，賴帝寬宥得免。瓦倫斯朝任聖庫伯，率兵護送阿里烏派盧基烏斯入亞歷山大，拘長老執事十九人，脅以刑罰令署阿里烏信條，不從，盡流放赫利奧波利斯；又以兵逼迫埃及諸主教。", "stats": [40, 40, 45, 50, 20], "lean": "無", "conf": "B", "src": "Theodoret 4.19"}
{"name_en": "Aphraates (monk)", "zh": "阿弗拉", "sei": "阿", "mei": "弗拉", "zh_full": "安條克的隱修士阿弗拉阿特斯", "sex": "m", "years": [360, 378], "birth": null, "death": null, "death_violent": false, "polity": "羅馬教會", "role": "宗教", "place": "安條克", "lat": 36.2, "lon": 36.15, "offices": [], "kin": [], "friends": ["Flavian I of Antioch", "Diodorus of Tarsus", "Giuliano Saba"], "foes": ["Valens"], "bio": "安條克隱修士。瓦倫斯逐正統派，阿弗拉阿特斯棄修道小屋入城牧養信眾。年老披裘疾行，帝於宮廊見而問之，答以「家宅失火，處女亦當出閨汲水救之」，帝語塞。宮中掌浴者出言恫嚇，旋即狂亂墜沸水而死，人以為其禱告之力。", "stats": [12, 15, 72, 45, 80], "lean": "無", "conf": "B", "src": "Theodoret 4.23"}
{"name_en": "Zeumatius", "zh": "宙馬提", "sei": "宙", "mei": "馬提", "zh_full": "宙馬提烏斯", "sex": "m", "years": [365, 378], "birth": null, "death": null, "death_violent": false, "polity": "羅馬教會", "role": "宗教", "place": "居魯斯", "lat": 36.75, "lon": 36.95, "offices": [], "kin": [], "friends": ["Traianus (magister peditum)"], "foes": [], "bio": "瓦倫斯時居魯斯一帶之苦修者。雖已失明，仍巡行各地堅固信眾，力抗阿里烏派。其修道小屋被敵焚毀，將軍特拉亞努斯為之重建，並供其所需。", "stats": [10, 10, 55, 40, 62], "lean": "無", "conf": "C", "src": "Theodoret 4.25"}
{"name_en": "Publius of Zeugma", "zh": "普布利", "sei": "普", "mei": "布利", "zh_full": "宙格瑪的普布利烏斯", "sex": "m", "years": [360, 380], "birth": null, "death": 380, "death_violent": false, "polity": "羅馬教會", "role": "宗教", "place": "宙格瑪", "lat": 37.06, "lon": 37.87, "offices": [], "kin": [], "friends": [], "foes": [], "bio": "宙格瑪一帶之苦修者，與同道保羅並以修行聞名於瓦倫斯之世。", "stats": [10, 10, 50, 35, 55], "lean": "無", "conf": "C", "src": "Theodoret 4.25"}
{"name_en": "Acepsimas of Cyrrhus", "zh": "阿塞普", "sei": "阿", "mei": "塞普", "zh_full": "居魯斯的阿塞普西馬斯", "sex": "m", "years": [340, 400], "birth": null, "death": null, "death_violent": false, "polity": "羅馬教會", "role": "宗教", "place": "居魯斯", "lat": 36.75, "lon": 36.95, "offices": [], "kin": [], "friends": [], "foes": [], "bio": "居魯斯地區之隱修士，自閉於小室中六十年，不見人亦不與人言，為瓦倫斯時名修士之一。", "stats": [8, 10, 45, 20, 50], "lean": "無", "conf": "C", "src": "Theodoret 4.25"}
