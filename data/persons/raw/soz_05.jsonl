{"name_en": "Asclepas of Gaza", "zh": "阿斯克", "sei": "阿", "mei": "斯克", "zh_full": "加沙的阿斯克勒帕斯", "sex": "m", "years": [325, 348], "birth": null, "death": null, "death_violent": false, "polity": "羅馬教會", "role": "宗教", "place": "加沙", "lat": 31.5, "lon": 34.47, "offices": ["加沙主教"], "kin": [], "friends": ["Athanasius of Alexandria", "Paul I of Constantinople", "Marcellus of Ancyra", "Pope Julius I"], "foes": ["Quintianus of Gaza"], "bio": "加沙主教，反對阿里烏派。被異派控告推倒祭壇而遭罷黜，教座改授昆提亞努斯。他逃往羅馬，與亞他那修、保羅、馬塞盧斯同獲儒略一世接納並恢復教座。塞爾迪卡會議上，東方派重申罷黜他，西方派則以凱撒利亞的優西比烏等人曾判他復位，宣告其無罪。", "stats": [18, 12, 55, 50, 55], "lean": "無", "conf": "B", "src": "Sozomen 3.8; 3.11; 3.12"}
{"name_en": "Quintianus of Gaza", "zh": "昆提安", "sei": "昆", "mei": "提安", "zh_full": "加沙的昆提亞努斯", "sex": "m", "years": [340, 343], "birth": null, "death": null, "death_violent": false, "polity": "阿里烏派", "role": "宗教", "place": "加沙", "lat": 31.5, "lon": 34.47, "offices": ["加沙主教"], "kin": [], "friends": [], "foes": ["Asclepas of Gaza"], "bio": "阿斯克勒帕斯被罷黜後，受命主持加沙教會。塞爾迪卡會議上，西方主教宣布他與亞歷山大里亞的格列高利、安卡拉的巴西爾同非主教，不得與之共融，甚至不以基督徒相待。", "stats": [15, 10, 45, 40, 35], "lean": "無", "conf": "B", "src": "Sozomen 3.8; 3.12"}
{"name_en": "Lucius of Adrianople", "zh": "盧基烏", "sei": "盧", "mei": "基烏", "zh_full": "阿德里安堡的盧基烏斯", "sex": "m", "years": [340, 348], "birth": null, "death": null, "death_violent": false, "polity": "羅馬教會", "role": "宗教", "place": "阿德里安堡", "lat": 41.68, "lon": 26.56, "offices": ["阿德里安堡主教"], "kin": [], "friends": ["Athanasius of Alexandria", "Pope Julius I"], "foes": [], "bio": "色雷斯阿德里安堡主教。另因他事被控，失去教座，寓居羅馬，與亞他那修等同獲儒略一世接納並恢復教座。塞爾迪卡會議上，西方主教以其控告者逃避對質，宣告他無罪。", "stats": [18, 15, 50, 45, 50], "lean": "無", "conf": "B", "src": "Sozomen 3.8; 3.12"}
{"name_en": "Martyrius (envoy of 345)", "zh": "馬爾提", "sei": "馬", "mei": "爾提", "zh_full": "馬爾提里烏斯", "sex": "m", "years": [345, 345], "birth": null, "death": null, "death_violent": false, "polity": "阿里烏派", "role": "宗教", "place": "安條克", "lat": 36.2, "lon": 36.16, "offices": ["主教"], "kin": [], "friends": ["Eudoxius of Antioch", "Macedonius of Mopsuestia"], "foes": [], "bio": "東方主教。安提阿會議三年後，東方派另擬一份冗長信經，稱「長行信經」，由他與歐多克修斯、馬其頓尼烏斯送往西方；西方主教以尼西亞信經已足，拒不接受。", "stats": [15, 10, 48, 42, 38], "lean": "無", "conf": "C", "src": "Sozomen 3.11"}
{"name_en": "Protogenes of Serdica", "zh": "普羅托", "sei": "普", "mei": "羅托", "zh_full": "塞爾迪卡的普羅托革尼斯", "sex": "m", "years": [325, 345], "birth": null, "death": null, "death_violent": false, "polity": "羅馬教會", "role": "宗教", "place": "塞爾迪卡", "lat": 42.7, "lon": 23.3, "offices": ["塞爾迪卡主教"], "kin": [], "friends": ["Hosius of Corduba", "Marcellus of Ancyra", "Pope Julius I"], "foes": ["Theodore of Heraclea"], "bio": "伊利里亞塞爾迪卡主教，與霍修斯同為塞爾迪卡會議西方主教的領袖。東方派以他先前曾判馬塞盧斯有罪，如今卻為之辯護，將他罷黜。會後他與霍修斯致書儒略，說明新擬信經只是闡明尼西亞之意，並無新說。", "stats": [20, 10, 60, 55, 58], "lean": "無", "conf": "B", "src": "Sozomen 3.11; 3.12"}
