{"i": 1091, "title": "Zarmandukht", "qid": "Q3574871", "skip": "", "zh": "扎爾曼杜", "sei": "扎爾", "mei": "曼杜", "zh_full": "扎爾曼杜赫特", "sex": "f", "birth": null, "death": null, "death_violent": false, "polity": "亞美尼亞", "role": "后妃", "place": "瓦加爾沙帕特", "lat": 40.16, "lon": 44.29, "offices": ["亞美尼亞王后", "攝政"], "kin": [{"rel": "配偶", "qid": "", "name": "Pap of Armenia"}, {"rel": "子", "qid": "", "name": "Arshak III"}, {"rel": "子", "qid": "", "name": "Vagharshak II"}], "friends": [], "foes": [], "bio": "阿薩息斯朝亞美尼亞國王帕普之妃。帕普於370年至374年在位。378年其二子阿沙克三世與瓦加爾沙克二世幼年共立為王，扎爾曼杜赫特以太后身分攝政，於羅馬與波斯之間維持亞美尼亞國祚，至386年前後。", "stats": [35, 12, 60, 64, 66], "lean": "無", "known": true}
{"i": 1092, "title": "Zazai of Gawazta", "qid": "Q123653472", "skip": "", "zh": "扎賽", "sei": "扎", "mei": "賽", "zh_full": "加瓦茲塔的扎賽", "sex": "m", "birth": null, "death": null, "death_violent": false, "polity": "薩珊波斯", "role": "宗教", "place": "美索不達米亞", "lat": 31.5, "lon": 47.0, "offices": ["曼達教祭司", "抄經者"], "kin": [{"rel": "子", "qid": "", "name": "Tabia"}], "friends": [], "foes": [], "bio": "3世紀曼達教祭司，納塔爾之子。在《聖禮書》、《千零十二問》等眾多曼達教經卷的題跋中列為最早的抄經者，其子（或弟子）塔比亞亦為抄經者，為後世曼達教經籍傳承之源。", "stats": [10, 10, 62, 30, 50], "lean": "無", "known": false}
