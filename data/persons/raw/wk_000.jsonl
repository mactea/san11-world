{"i": 6, "title": "Abba Kohen Bardela", "qid": "Q4663647", "skip": "", "zh": "巴德拉", "sei": "巴", "mei": "德拉", "zh_full": "阿巴·科亨·巴爾德拉", "sex": "m", "birth": null, "death": null, "death_violent": false, "polity": "羅馬帝國", "role": "学者", "place": "巴勒斯坦", "lat": 32.0, "lon": 35.0, "offices": [], "kin": [], "friends": [], "foes": [], "bio": "猶太學者，屬坦拿最後一代，約活動於3世紀初。傳下的少數律法多涉拉比民法，另有若干經文詮釋存世，曾以巴蘭受驢責備、約瑟喝止兄長為喻，警世人難當全知之主的審判。", "stats": [10, 10, 62, 30, 40], "lean": "無", "known": false}
{"i": 7, "title": "Abba Yudan", "qid": "Q6936606", "skip": "", "zh": "阿布丹", "sei": "阿", "mei": "布丹", "zh_full": "阿巴·尤丹", "sex": "m", "birth": null, "death": null, "death_violent": false, "polity": "羅馬帝國", "role": "学者", "place": "塞佛瑞斯", "lat": 32.75, "lon": 35.28, "offices": ["書記"], "kin": [], "friends": ["Judah ha-Nasi"], "foes": ["Ishmael ben Jose"], "bio": "又稱阿比丹，巴勒斯坦猶太學者，屬第一代阿摩拉，約活動於3世紀初。為猶大親王的弟子兼書記，對學院同儕時嫌專橫。曾當眾斥責欲擠入學院的以實瑪利·本·約西「不配向拉比求學」，因而結怨。", "stats": [10, 10, 55, 30, 35], "lean": "無", "known": false}
