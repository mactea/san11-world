{"name_en": "Hayr (mardpet)", "zh": "海爾", "sei": "海", "mei": "爾", "zh_full": "「宦官長」海爾", "sex": "m", "years": [340, 360], "birth": null, "death": 360, "death_violent": true, "polity": "亞美尼亞（阿沙克王朝）", "role": "文臣", "place": "亞美尼亞", "lat": 39.9, "lon": 44.5, "offices": ["宦官長（馬爾德佩特）"], "kin": [], "friends": ["Tiran of Armenia", "Arshak II"], "foes": ["St. Nerses I", "Shavasp Artsruni"], "bio": "宦官長，性陰狠報復，提蘭王時誅殺諸納哈拉爾家族，阿爾沙克王時再行屠戮。巡視領地至塔隆，於阿什季沙特醉後辱罵歷代王室，揚言奪聖地建王宮，納爾謝斯預言其敗。行至梅祖爾赫，為阿茨魯尼家的沙瓦斯普誘入林中射殺。", "stats": [45, 40, 58, 62, 25], "lean": "無", "conf": "B", "src": "Faustus 4.14"}
{"name_en": "Shavasp Artsruni", "zh": "沙瓦斯普", "sei": "沙瓦", "mei": "斯普", "zh_full": "沙瓦斯普·阿茨魯尼", "sex": "m", "years": [355, 360], "birth": null, "death": null, "death_violent": false, "polity": "亞美尼亞（阿沙克王朝）", "role": "武将", "place": "梅祖爾赫", "lat": 39.1, "lon": 40.0, "offices": [], "kin": [], "friends": [], "foes": ["Hayr (mardpet)"], "bio": "阿茨魯尼家族之人。宦官長海爾行至幼發拉底河畔梅祖爾赫，沙瓦斯普詐稱見白熊，誘其棄車騎馬入密林，自後放箭射穿之。", "stats": [50, 72, 55, 35, 40], "lean": "弩", "conf": "C", "src": "Faustus 4.14"}
{"name_en": "Andovk Siuni", "zh": "安多克", "sei": "安", "mei": "多克", "zh_full": "安多克·休尼", "sex": "m", "years": [355, 365], "birth": null, "death": null, "death_violent": false, "polity": "亞美尼亞（阿沙克王朝）", "role": "武将", "place": "休尼克", "lat": 39.5, "lon": 46.0, "offices": ["休尼克領主"], "kin": [{"rel": "女", "name": "Pharantzem"}, {"rel": "女婿", "name": "Arshak II"}], "friends": ["Arshak II", "Vassak Mamikonian"], "foes": ["Shapur II"], "bio": "休尼克領主，王后帕蘭澤姆之父。阿爾沙克二世助沙普爾二世在尼西比斯大破羅馬軍，沙普爾欲以女妻之。安多克恐其女失寵，以重金賄賂瓦薩克與眾臣，又買通波斯近臣誣稱沙普爾欲殺阿爾沙克，致阿爾沙克連夜棄營出逃。", "stats": [62, 55, 72, 60, 58], "lean": "騎", "conf": "B", "src": "Faustus 4.20"}
